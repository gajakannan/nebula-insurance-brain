  {
    "@id": "urn:nebula:ont:foundation.account",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:nebula:ont:foundation.role-scope"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en-US",
        "@value": "The carrier's customer relationship with exactly one insured or prospective insured organization, with at most one designated parent account."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en-US",
        "@value": "Account"
      }
    ]
  },
  {
    "@id": "urn:nebula:ont:foundation.account-status",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:nebula:ont:foundation.thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en-US",
        "@value": "The lifecycle state of an account in the teaching vocabulary: CURRENT means not closed."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en-US",
        "@value": "Account status"
      }
    ]
  },
