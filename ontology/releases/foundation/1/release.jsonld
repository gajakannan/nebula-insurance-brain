    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en-US",
        "@value": "The account designated as this account's parent for roll-up; never computed from ownership."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
