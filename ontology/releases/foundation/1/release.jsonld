      },
      {
        "@id": "urn:nebula:ont:foundation.account-status"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en-US",
        "@value": "Account status CLOSED in the teaching vocabulary (ADR-0070 section 2)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en-US",
        "@value": "Closed"
      }
    ]
  },
  {
    "@id": "urn:nebula:ont:foundation.account-status.current",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
