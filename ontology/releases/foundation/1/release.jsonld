        "@id": "urn:nebula:ont:foundation.thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en-US",
        "@value": "An attributable choice made by a party or principal under stated authority."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en-US",
        "@value": "Decision"
      }
