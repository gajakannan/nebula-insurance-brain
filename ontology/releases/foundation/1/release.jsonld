      {
        "@language": "en-US",
        "@value": "Account status CURRENT in the teaching vocabulary (ADR-0070 section 2)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en-US",
        "@value": "Current"
      }
    ]
  },
  {
