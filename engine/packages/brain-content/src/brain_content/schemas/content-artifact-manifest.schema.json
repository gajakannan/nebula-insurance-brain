{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebula.local/schemas/content-artifact-manifest.schema.json",
  "title": "ContentArtifactManifest",
  "description": "Manifest of one accepted parse-once content artifact bundle (master blueprint sections 80, 81, 108.1; F0001-S0003). F0004 compatibility clarification: source.pdf is the observed retained-PDF filename; no v2 metadata is synthesized for legacy artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_contract_version",
    "tenant_id",
    "knowledge_base_id",
    "document_id",
    "version_id",
    "artifact_id",
    "source_sha256",
    "artifact_sha256",
    "docling_document",
    "files",
    "execution",
    "extraction_quality",
    "page_count",
    "coordinate_origin",
    "offset_encoding",
    "created_at"
  ],
  "properties": {
    "artifact_contract_version": {
      "const": 1
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "knowledge_base_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "version_id": {
      "type": "string",
      "format": "uuid"
    },
    "artifact_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "docling_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema_version",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "docling-document.json"
        },
        "schema_version": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "enum": [
              "docling-document.json",
              "normalized.md",
              "blocks.jsonl",
              "tables.jsonl",
              "layout.jsonl",
              "original.pdf",
              "source.pdf"
            ]
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parser_package_version",
        "model_artifact_digests",
        "configuration_hash",
        "environment_digest"
      ],
      "properties": {
        "parser_package_version": {
          "type": "string"
        },
        "model_artifact_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "configuration_hash": {
          "$ref": "#/$defs/sha256"
        },
        "environment_digest": {
          "type": "string"
        }
      }
    },
    "extraction_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "failed_pages",
        "warnings"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "failed_pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ocr": {
          "description": "F0005-S0001-AC2 (ADR-0073 amendment 2026-10-27): OCR observed during this conversion. Absent or null means not observed (historical producers); never inferred.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "page_count",
                "pages",
                "engine"
              ],
              "properties": {
                "page_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "pages": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "uniqueItems": true
                },
                "engine": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "version",
                        "model",
                        "model_version"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "version": {
                          "type": "string",
                          "minLength": 1
                        },
                        "model": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "model_version": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "page_count": {
      "type": "integer",
      "minimum": 0
    },
    "coordinate_origin": {
      "const": "top_left"
    },
    "offset_encoding": {
      "const": "unicode_code_points"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
