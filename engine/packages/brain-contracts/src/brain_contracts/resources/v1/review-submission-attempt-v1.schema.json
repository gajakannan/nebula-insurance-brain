{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebula.local/schemas/review-submission-attempt-v1.schema.json",
  "title": "Non-applied review submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "tenant_id",
    "knowledge_base_id",
    "review_item_id",
    "review_batch_id",
    "original_assertion_id",
    "reviewer_principal_id",
    "submitted_at",
    "event_sha256",
    "assertion_version",
    "action",
    "reason_code",
    "corrected_value",
    "evidence",
    "reviewer_comment",
    "outcome",
    "authorization_decision_id"
  ],
  "properties": {
    "contract": {
      "const": "review-submission-attempt/v1"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "knowledge_base_id": {
      "type": "string",
      "format": "uuid"
    },
    "review_item_id": {
      "type": "string",
      "format": "uuid"
    },
    "review_batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "original_assertion_id": {
      "type": "string",
      "format": "uuid"
    },
    "reviewer_principal_id": {
      "type": "string",
      "format": "uuid"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assertion_version": {
      "type": "integer",
      "minimum": 1
    },
    "action": {
      "enum": [
        "ACCEPT",
        "CORRECT",
        "REJECT",
        "BLOCKED"
      ]
    },
    "reason_code": {
      "enum": [
        "MISREAD_VALUE",
        "WRONG_REGION",
        "NOT_IN_SOURCE",
        "OUT_OF_SCOPE",
        "EVIDENCE_UNRESOLVED",
        null
      ]
    },
    "corrected_value": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "evidence": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "reviewer_comment": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "enum": [
        "ALREADY_DECIDED",
        "BATCH_REFUSED"
      ]
    },
    "authorization_decision_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
