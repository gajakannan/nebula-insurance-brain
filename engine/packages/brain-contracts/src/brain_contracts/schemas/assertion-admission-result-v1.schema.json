{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebula.local/schemas/assertion-admission-result-v1.schema.json",
  "title": "AssertionAdmissionResultV1",
  "description": "F0006 server-computed protected result. F0016 must durably persist outcomes before marking a run complete. This internal result is not an HTTP endpoint or general log payload. No field grants permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "artifact_id",
    "accepted",
    "outcomes",
    "requires_partial"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "artifact_id": {
      "type": "string",
      "format": "uuid"
    },
    "accepted": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record",
          "server_evidence",
          "review_required",
          "reasons",
          "blocked_operations",
          "created_by",
          "created_at"
        ],
        "properties": {
          "record": {
            "$ref": "assertion-record-v2.schema.json"
          },
          "server_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id",
                "artifact_id",
                "block_id",
                "quote",
                "normalization_version",
                "precision",
                "selector",
                "text_origin",
                "origin_qualification",
                "producer",
                "producer_confidence"
              ],
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "artifact_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "block_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "normalization_version": {
                  "const": "f0006-grounding-v1"
                },
                "precision": {
                  "type": "string",
                  "enum": [
                    "span",
                    "table_cell",
                    "block",
                    "page",
                    "document",
                    "unresolved"
                  ]
                },
                "selector": {
                  "type": "object"
                },
                "text_origin": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "STATED",
                        "OCR",
                        "TRANSCRIBED",
                        "DESCRIBED"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "origin_qualification": {
                  "type": "string",
                  "enum": [
                    "qualified",
                    "legacy_unqualified"
                  ]
                },
                "producer": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "producer_confidence": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "review_required": {
            "type": "boolean"
          },
          "reasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "OPEN_STATEMENT",
                "MOOD",
                "DESCRIBED_EVIDENCE",
                "UNRESOLVED_EVIDENCE",
                "LEGACY_UNQUALIFIED"
              ]
            }
          },
          "blocked_operations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "RESOLVE",
                "CREATE",
                "AUTO_ACCEPT",
                "CLOSE",
                "SUPERSEDE"
              ]
            }
          },
          "created_by": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_index",
          "item_path",
          "candidate_id",
          "block_id",
          "disposition",
          "reason",
          "raw_item_sha256",
          "excerpt",
          "model_id",
          "prompt_hash"
        ],
        "properties": {
          "item_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "item_path": {
            "type": "string",
            "minLength": 1
          },
          "candidate_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "block_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "REJECTED",
              "SIGNAL",
              "RUN_ISSUE"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "QUOTE_NOT_IN_SOURCE",
              "NAME_NOT_IN_QUOTE",
              "NAME_CLAIMED_BY_ANOTHER",
              "TIME_NOT_IN_QUOTE",
              "UNKNOWN_REFERENCE",
              "OBJECT_UNDECLARED",
              "MALFORMED_ITEM",
              "TRUNCATED_OUTPUT",
              "BLOCK_UNINTERPRETED"
            ]
          },
          "raw_item_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "excerpt": {
            "type": [
              "string",
              "null"
            ]
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "prompt_hash": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "reason": {
                  "const": "OBJECT_UNDECLARED"
                }
              }
            },
            "then": {
              "properties": {
                "disposition": {
                  "const": "SIGNAL"
                }
              }
            }
          }
        ]
      }
    },
    "requires_partial": {
      "type": "boolean"
    }
  },
