{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebula.local/schemas/interpretation-result.schema.json",
  "title": "InterpretationResult",
  "description": "Provider-neutral output of one semantic interpretation run over a persisted content artifact (master blueprint section 108.3; F0001-S0003).",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "artifact_id", "status", "entities", "assertions", "relationships", "quality_signals", "warnings", "failed_chunks", "run_configuration", "counters", "created_at"],
  "properties": {
    "run_id": { "type": "string", "format": "uuid" },
    "artifact_id": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["complete", "partial", "failed"] },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/candidate_entity" } },
    "assertions": { "type": "array", "items": { "$ref": "#/$defs/candidate_assertion" } },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/candidate_relationship" } },
    "quality_signals": { "type": "object", "additionalProperties": { "type": "number" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "failed_chunks": { "type": "array", "items": { "type": "string" } },
    "run_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "model_id", "endpoint_hash", "prompt_hash", "schema_hash", "context_limit", "profile_id", "profile_version"],
      "properties": {
        "backend": { "const": "openai_compatible" },
        "model_id": { "type": "string" },
        "model_revision": { "type": ["string", "null"] },
        "endpoint_hash": { "type": "string" },
        "prompt_hash": { "type": "string" },
        "schema_hash": { "type": "string" },
        "context_limit": { "type": "integer", "minimum": 1 },
        "profile_id": { "type": "string" },
        "profile_version": { "type": "string" }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversion_calls", "ocr_calls", "model_calls", "prompt_tokens", "completion_tokens"],
      "properties": {
        "conversion_calls": { "type": "integer", "minimum": 0 },
        "ocr_calls": { "type": "integer", "minimum": 0 },
        "model_calls": { "type": "integer", "minimum": 0 },
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "provenance_ledger_ref": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "precision": { "type": "string", "enum": ["span", "table_cell", "block", "page", "document", "unresolved"] },
    "interpretation_basis": { "type": "string", "enum": ["EXPLICIT", "INFERRED", "AMBIGUOUS"] },
    "bounding_box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "x0", "y0", "x1", "y1"],
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "x0": { "type": "number" }, "y0": { "type": "number" }, "x1": { "type": "number" }, "y1": { "type": "number" }
      }
    },
    "evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "precision"],
      "properties": {
        "artifact_id": { "type": "string", "format": "uuid" },
        "block_id": { "type": ["string", "null"] },
        "page": { "type": ["integer", "null"], "minimum": 1 },
        "bbox": { "oneOf": [{ "$ref": "#/$defs/bounding_box" }, { "type": "null" }] },
        "char_start": { "type": ["integer", "null"], "minimum": 0 },
        "char_end": { "type": ["integer", "null"], "minimum": 0 },
        "precision": { "$ref": "#/$defs/precision" }
      }
    },
    "candidate_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entity_type", "label", "evidence"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "entity_type": { "type": "string" },
        "label": { "type": "string" },
        "external_id": { "type": ["string", "null"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence_binding" } }
      }
    },
    "candidate_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject_type", "slot_type", "value", "evidence", "interpretation_basis"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "subject_ref": { "type": ["string", "null"] },
        "subject_type": { "type": "string" },
        "slot_type": { "type": "string" },
        "value": { "type": "object" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence_binding" } },
        "model_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "interpretation_basis": { "$ref": "#/$defs/interpretation_basis" }
      }
    },
    "candidate_relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relation_type", "source_entity_id", "target_entity_id", "evidence", "interpretation_basis"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "relation_type": { "type": "string" },
        "source_entity_id": { "type": "string", "format": "uuid" },
        "target_entity_id": { "type": "string", "format": "uuid" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence_binding" } },
        "model_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "interpretation_basis": { "$ref": "#/$defs/interpretation_basis" }
      }
    }
  }
}
