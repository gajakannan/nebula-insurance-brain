# Nebula Insurance Brain — local environment template.
# Copy to .env and fill with real values. Do NOT commit secrets (F0001-S0002).

# authentik (see docker/authentik/blueprints/nebula-brain-dev.yaml)
# Generate AUTHENTIK_SECRET_KEY with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
AUTHENTIK_SECRET_KEY=replace_me
AUTHENTIK_BOOTSTRAP_PASSWORD=replace_me

# PostgreSQL (matches docker-compose.yml defaults; override only for local port conflicts)
BRAIN_DATABASE_URL=postgresql+psycopg://brain:brain@localhost:5432/brain

# Local inference (vLLM, host GPU, outside Compose — see docker/local-inference-runbook.md).
# The API key itself lives in ~/.brain-secrets (0600), never in .env or the repo.
BRAIN_INFERENCE_BASE_URL=http://localhost:8000/v1
BRAIN_INFERENCE_MODEL=microsoft/Phi-4-mini-instruct
BRAIN_INFERENCE_API_KEY_ENV=BRAIN_INFERENCE_API_KEY
BRAIN_INFERENCE_CONTEXT_LIMIT=4096
