{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebula.local/schemas/review-decision.schema.json",
  "title": "ReviewDecision",
  "description": "Governed outcome of one human review; corrections append and never rewrite the original assertion (master blueprint section 75, ADR-0037; F0001-S0004).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "review_item_id", "action", "reviewer_principal_id", "decided_at", "assertion_version", "stale", "event_sha256"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "review_item_id": { "type": "string", "format": "uuid" },
    "action": { "type": "string", "enum": ["ACCEPT", "CORRECT", "REJECT"] },
    "corrected_value": { "type": ["object", "null"] },
    "corrected_assertion_id": { "type": ["string", "null"], "format": "uuid" },
    "reviewer_principal_id": { "type": "string", "format": "uuid" },
    "reviewer_comment": { "type": ["string", "null"] },
    "decided_at": { "type": "string", "format": "date-time" },
    "assertion_version": { "type": "integer", "minimum": 1 },
    "stale": { "type": "boolean" },
    "event_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
