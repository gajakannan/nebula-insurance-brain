@prefix pc: <https://example.invalid/nebula/ont/commercial-example/> .
@prefix d: <https://example.invalid/nebula/data/> .
# Independent hypothetical input: two accounts for one organization, such as a grouping account
# reusing a subsidiary. Each organization has exactly one account in a tenant (ADR-0070).
d:EX-PC-GAP-ORG a pc:Organization .
d:EX-PC-GAP-ACCOUNT-1 a pc:Account ; pc:accountOrganization d:EX-PC-GAP-ORG .
d:EX-PC-GAP-ACCOUNT-2 a pc:Account ; pc:accountOrganization d:EX-PC-GAP-ORG .
