@prefix pc: <https://example.invalid/nebula/ont/commercial-example/> .
@prefix d: <https://example.invalid/nebula/data/> .
# Independent hypothetical input: two current owners recorded at 80 percent each of one organization.
# Each percentage is valid alone; together they exceed 100 (ADR-0070).
d:EX-PC-GAP-JV a pc:Organization .
d:EX-PC-GAP-OWNER-A a pc:Organization .
d:EX-PC-GAP-OWNER-B a pc:Organization .
d:EX-PC-GAP-INTEREST-A a pc:OwnershipInterest ; pc:owner d:EX-PC-GAP-OWNER-A ;
    pc:ownedOrganization d:EX-PC-GAP-JV ; pc:ownershipPercent 80.00 .
d:EX-PC-GAP-INTEREST-B a pc:OwnershipInterest ; pc:owner d:EX-PC-GAP-OWNER-B ;
    pc:ownedOrganization d:EX-PC-GAP-JV ; pc:ownershipPercent 80.00 .
