@prefix d: <https://example.invalid/nebula/data/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# Independent hypothetical input: complete money without its insured-location scope.
d:EX-PC-GAP-PROPERTY a pc:PropertyCoverage ; pc:hasMonetaryTerm d:EX-PC-GAP-BPP .
d:EX-PC-GAP-BPP a pc:Limit ; pc:basis "BusinessPersonalProperty" ;
    pc:amount "200000.00"^^xsd:decimal ; pc:currency "USD" .
