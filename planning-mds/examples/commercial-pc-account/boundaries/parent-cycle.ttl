@prefix pc: <https://example.invalid/nebula/ont/commercial-example/> .
@prefix d: <https://example.invalid/nebula/data/> .
# Independent hypothetical input: three accounts whose designated parents form a loop. Each has one
# parent, but a roll-up would never end and would count policies twice (ADR-0070).
d:EX-PC-GAP-ORG-A a pc:Organization .
d:EX-PC-GAP-ORG-B a pc:Organization .
d:EX-PC-GAP-ORG-C a pc:Organization .
d:EX-PC-GAP-ACCOUNT-A a pc:Account ; pc:accountOrganization d:EX-PC-GAP-ORG-A ; pc:parentAccount d:EX-PC-GAP-ACCOUNT-C .
d:EX-PC-GAP-ACCOUNT-B a pc:Account ; pc:accountOrganization d:EX-PC-GAP-ORG-B ; pc:parentAccount d:EX-PC-GAP-ACCOUNT-A .
d:EX-PC-GAP-ACCOUNT-C a pc:Account ; pc:accountOrganization d:EX-PC-GAP-ORG-C ; pc:parentAccount d:EX-PC-GAP-ACCOUNT-B .
