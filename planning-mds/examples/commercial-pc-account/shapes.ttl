@prefix pc: <https://example.invalid/nebula/ont/commercial-example/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Supplied values and role-record structure; missing money is not a global rejection.
pc:SuppliedMoneyShape a sh:NodeShape ;
    sh:targetClass pc:Limit, pc:Deductible ;
    sh:property [ sh:path pc:amount ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path pc:currency ; sh:datatype xsd:string ; sh:pattern "^[A-Z]{3}$" ] ;
    sh:property [ sh:path pc:basis ; sh:datatype xsd:string ] .

pc:RoleRecordShape a sh:NodeShape ; sh:targetClass pc:RoleAssignment ;
    sh:property [ sh:path pc:roleParty ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( [ sh:class pc:Person ] [ sh:class pc:Organization ] ) ] ;
    sh:property [ sh:path pc:roleKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pc:RoleKind ] ;
    sh:property [ sh:path pc:roleScope ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

# An admitted projection record identifies its term; this is not a document extraction requirement.
pc:CoverageReferenceShape a sh:NodeShape ;
    sh:targetSubjectsOf pc:coverageOf ;
    sh:property [ sh:path pc:coverageOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pc:PolicyTerm ] .
