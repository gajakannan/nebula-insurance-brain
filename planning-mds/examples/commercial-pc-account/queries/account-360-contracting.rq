PREFIX pc: <https://example.invalid/nebula/ont/commercial-example/>
PREFIX d: <https://example.invalid/nebula/data/>
# Expected: three rows. The Contracting account owns the GL policy. It is also a named insured on
# the auto and umbrella policies, which belong to the Workshop account, so they appear as
# "named insured" rather than as Contracting's own policies.
SELECT ?policy ?number ?relation WHERE {
  d:EX-PC-ACCOUNT-CONTRACTOR pc:accountOrganization ?organization .
  ?policy pc:policyNumber ?number .
  {
    ?policy pc:forAccount d:EX-PC-ACCOUNT-CONTRACTOR .
    BIND("owner" AS ?relation)
  } UNION {
    ?term pc:termOf ?policy .
    ?assignment pc:roleParty ?organization ; pc:roleKind d:EX-PC-ROLE-NamedInsured ; pc:roleScope ?term .
    FILTER NOT EXISTS { ?policy pc:forAccount d:EX-PC-ACCOUNT-CONTRACTOR }
    BIND("named insured" AS ?relation)
  }
} ORDER BY ?policy
