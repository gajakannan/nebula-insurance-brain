PREFIX pc: <https://example.invalid/nebula/ont/commercial-example/>
PREFIX d: <https://example.invalid/nebula/data/>
# Expected: four rows in the supplied snapshot. Ownership independently includes GL and the
# local program policy, even without a current insured role. Their role is optional enrichment.
# Non-owned auto and umbrella appear only through Contracting's current named-insured roles.
SELECT DISTINCT ?policy ?number ?relation ?insuredRole WHERE {
  {
    ?policy pc:forAccount d:EX-PC-ACCOUNT-CONTRACTOR .
    BIND ("owner" AS ?relation)
    OPTIONAL {
      d:EX-PC-ACCOUNT-CONTRACTOR pc:accountOrganization ?organization .
      ?term pc:termOf ?policy .
      ?assignment pc:roleParty ?organization ; pc:roleKind ?insuredRole ; pc:roleScope ?term .
      VALUES ?insuredRole { d:EX-PC-ROLE-FirstNamedInsured d:EX-PC-ROLE-AdditionalNamedInsured }
    }
  } UNION {
    d:EX-PC-ACCOUNT-CONTRACTOR pc:accountOrganization ?organization .
    ?term pc:termOf ?policy .
    ?assignment pc:roleParty ?organization ; pc:roleKind ?insuredRole ; pc:roleScope ?term .
    VALUES ?insuredRole { d:EX-PC-ROLE-FirstNamedInsured d:EX-PC-ROLE-AdditionalNamedInsured }
    FILTER NOT EXISTS { ?policy pc:forAccount d:EX-PC-ACCOUNT-CONTRACTOR }
    BIND ("named insured" AS ?relation)
  }
  ?policy pc:policyNumber ?number .
} ORDER BY ?policy
