PREFIX pc: <https://example.invalid/nebula/ont/commercial-example/>
PREFIX d: <https://example.invalid/nebula/data/>
# Expected: nine rows. A broker contact reaches what their role names, nothing more.
# Account scope: the account's own policies. Jordan: Holdings (the master program) and Workshop
# (BOP, auto, umbrella, its local program policy). Sam: Contracting (GL, its local policy).
# Policy-term scope: that policy only. Sam: the umbrella; Drew (Fleet Brokers): the auto policy.
# Nobody reaches an account through a parent, a master program or a policy-only role.
# This is the data an access check would read; no authorization code runs here (EX-PC-018).
SELECT ?person ?scope ?policy WHERE {
  ?assignment pc:roleParty ?person ; pc:roleKind d:EX-PC-ROLE-BrokerContact ; pc:roleScope ?scope .
  {
    ?scope a pc:Account .
    ?policy pc:forAccount ?scope ; pc:policyNumber ?number .
  } UNION {
    ?scope pc:termOf ?policy .
  }
} ORDER BY ?person ?scope ?policy
