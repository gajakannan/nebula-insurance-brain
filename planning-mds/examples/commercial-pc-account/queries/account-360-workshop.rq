PREFIX pc: <https://example.invalid/nebula/ont/commercial-example/>
PREFIX d: <https://example.invalid/nebula/data/>
# Expected: three rows (BOP, Auto, Umbrella). The Workshop account sees every policy naming its
# organization, including the auto and umbrella policies it shares with the Contracting account.
# It does not see the GL policy, which names only Contracting.
SELECT ?policy ?number ?product WHERE {
  d:EX-PC-ACCOUNT-WORKSHOP pc:accountOrganization ?organization .
  ?assignment pc:roleParty ?organization ; pc:roleKind d:EX-PC-ROLE-NamedInsured ; pc:roleScope ?term .
  ?term pc:termOf ?policy .
  ?policy pc:policyNumber ?number ; pc:productType ?product .
} ORDER BY ?policy
