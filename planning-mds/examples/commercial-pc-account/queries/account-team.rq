PREFIX pc: <https://example.invalid/nebula/ont/commercial-example/>
PREFIX d: <https://example.invalid/nebula/data/>
# Expected: six rows of who does what across the Holdings hierarchy: the broker contact and risk
# manager (Holdings account), the Workshop account contact (the same person as the risk manager),
# the BOP and GL underwriters (policy terms), and the MGA underwriter (submission).
# These are domain roles for Account 360 and routing. None of them grants access.
SELECT DISTINCT ?person ?role ?scope ?actsFor WHERE {
  ?assignment pc:roleParty ?person ; pc:roleKind ?role ; pc:roleScope ?scope ; pc:actsFor ?actsFor .
  ?person a pc:Person .
  {
    ?scope pc:parentAccount* d:EX-PC-ACCOUNT .
  } UNION {
    ?scope pc:forAccount ?account .
    ?account pc:parentAccount* d:EX-PC-ACCOUNT .
  } UNION {
    ?scope pc:termOf ?policy .
    ?insured pc:roleScope ?scope ; pc:roleKind d:EX-PC-ROLE-NamedInsured ; pc:roleParty ?organization .
    ?account pc:accountOrganization ?organization ; pc:parentAccount* d:EX-PC-ACCOUNT .
  }
} ORDER BY ?person ?scope
