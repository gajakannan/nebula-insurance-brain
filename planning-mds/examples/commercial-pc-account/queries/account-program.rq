PREFIX pc: <https://example.invalid/nebula/ont/commercial-example/>
PREFIX d: <https://example.invalid/nebula/data/>
# Expected: seven rows. The Holdings roll-up lists each policy once, under the one account it
# belongs to: the property master program under Holdings; BOP, auto, umbrella and a local program
# policy under Workshop; GL and a local program policy under Contracting. The auto line has its
# own placement broker.
SELECT ?account ?policy ?number ?product ?carrier ?broker WHERE {
  ?account pc:parentAccount* d:EX-PC-ACCOUNT .
  ?policy pc:forAccount ?account ; pc:policyNumber ?number ; pc:productType ?product .
  ?term pc:termOf ?policy .
  ?carrierAssignment pc:roleScope ?term ; pc:roleKind d:EX-PC-ROLE-Carrier ; pc:roleParty ?carrier .
  ?brokerAssignment pc:roleScope ?term ; pc:roleKind d:EX-PC-ROLE-PlacementBroker ; pc:roleParty ?broker .
} ORDER BY ?policy
