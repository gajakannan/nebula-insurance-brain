PREFIX pc: <https://example.invalid/nebula/ont/commercial-example/>
PREFIX d: <https://example.invalid/nebula/data/>
# Expected: six rows. The Holdings roll-up reaches policies through each descendant account's
# organization holding a named-insured role (BOP/Workshop, GL/Contracting, Auto and Umbrella/both).
# Account parentage never creates a named-insured role. The auto line has its own broker of record.
SELECT ?account ?policy ?number ?product ?carrier ?broker ?insured WHERE {
  ?account pc:parentAccount* d:EX-PC-ACCOUNT ; pc:accountOrganization ?insured .
  ?insuredAssignment pc:roleParty ?insured ; pc:roleKind d:EX-PC-ROLE-NamedInsured ; pc:roleScope ?term .
  ?term pc:termOf ?policy .
  ?policy pc:policyNumber ?number ; pc:productType ?product .
  ?carrierAssignment pc:roleScope ?term ; pc:roleKind d:EX-PC-ROLE-Carrier ; pc:roleParty ?carrier .
  ?brokerAssignment pc:roleScope ?term ; pc:roleKind d:EX-PC-ROLE-PlacementBroker ; pc:roleParty ?broker .
} ORDER BY ?policy ?insured
