{"schema_version":1,"timestamp":"2026-10-11T23:10:11-04:00","cwd":"{NEBULA_PRODUCT_ROOT}","command":"python3 -c 'import copy\nimport json\nfrom pathlib import Path\nfolder = Path(\"planning-mds/examples/commercial-pc-account\")\npath = folder / \"records.json\"\ndata = json.loads(path.read_text())\nevidence = next(e for e in data[\"evidence\"] if e[\"id\"] == \"EX-PC-EV-ACCOUNT\")\nsentence = \"All four accounts are current as of this document date; no closure has been reported.\"\nold = \"All four are separate legal organizations, and each has its own account.\"\nsource = folder / \"source-package.md\"\nsource.write_text(source.read_text().replace(old, old + \" \" + sentence))\nevidence[\"quote\"] = evidence[\"quote\"].replace(old, old + \" \" + sentence)\nreview = next(r for r in data[\"reviews\"] if r[\"id\"] == \"EX-PC-REVIEW-INITIAL\")\nfor entity in data[\"entities\"]:\n    if entity[\"type\"] != \"pc:Account\":\n        continue\n    suffix = entity[\"id\"].removeprefix(\"EX-PC-\")\n    aid, sid = f\"EX-PC-A-STATUS-{suffix}\", f\"EX-PC-SLOT-STATUS-{suffix}\"\n    data[\"slots\"].append({\"id\": sid, \"subject_ref\": entity[\"id\"], \"predicate\": \"pc:accountStatus\", \"qualifiers\": {}})\n    data[\"assertions\"].append({\"id\": aid, \"subject_ref\": entity[\"id\"], \"predicate\": \"pc:accountStatus\",\n        \"object\": {\"value\": \"CURRENT\", \"datatype\": \"xsd:string\"}, \"evidence_ref\": evidence[\"id\"],\n        \"mood\": \"ASSERTION\", \"origin\": \"DOCUMENT_INTERPRETATION\", \"run_ref\": \"EX-PC-RUN-ACCOUNT\"})\n    fact = copy.deepcopy(data[\"facts\"][0])\n    fact.update(id=f\"EX-PC-F-STATUS-{suffix}\", slot_id=sid, assertion_ref=aid)\n    data[\"facts\"].append(fact)\n    review[\"assertion_refs\"].append(aid)\npath.write_text(json.dumps(data, indent=2, ensure_ascii=False) + \"\\n\")\nfor boundary in (folder / \"boundaries\").glob(\"*.ttl\"):\n    if boundary.name == \"account-close-reopen.ttl\":\n        continue\n    text = boundary.read_text()\n    text = text.replace(\"a pc:Account ;\", '\"'\"'a pc:Account ; pc:accountStatus \"CURRENT\" ;'\"'\"')\n    boundary.write_text(text)\npath = folder / \"release.yaml\"\ntext = path.read_text()\ntext = text.replace(\"activation: none;\", \"- file: boundaries/account-close-reopen.ttl\\n  sha256: \" + \"0\" * 64 + \"\\nactivation: none;\")\npath.write_text(text)\npath = folder / \"README.md\"\ntext = path.read_text().replace(\"**111 identity rows, 10 evidence excerpts, 238 assertions, 234 slots, 237 fact versions**\", \"**111 identity rows, 10 evidence excerpts, 242 assertions, 238 slots, 241 fact versions**\")\ntext = text.replace(\"every organization has its own account.\", \"each insured organization has at most one current account in the tenant. All four accounts in this snapshot are current; a closed account retains its identity and history and permits a replacement (EX-PC-021).\")\npath.write_text(text)\n'","exit_code":0,"artifacts":[],"redactions":[]}
