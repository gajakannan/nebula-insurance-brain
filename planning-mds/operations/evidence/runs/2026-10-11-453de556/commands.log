{"schema_version":1,"timestamp":"2026-10-11T23:17:40-04:00","cwd":"{NEBULA_PRODUCT_ROOT}","command":"python3 -c 'import json\nimport subprocess\nfrom pathlib import Path\npath=\"planning-mds/examples/commercial-pc-account/records.json\"\nbefore=json.loads(subprocess.check_output([\"git\",\"show\",\"HEAD:\"+path],text=True))\nafter=json.loads(Path(path).read_text())\nfor group in (\"entities\",\"runs\",\"commits\"):\n    assert after[group] == before[group], group\nfor group in (\"assertions\",\"slots\",\"facts\"):\n    assert after[group][:len(before[group])] == before[group], group\n    assert len(after[group]) == len(before[group])+4, group\nassert after[\"evidence\"][1:] == before[\"evidence\"][1:]\nassert after[\"reviews\"][1:] == before[\"reviews\"][1:]\nassert after[\"reviews\"][0][\"assertion_refs\"][:len(before[\"reviews\"][0][\"assertion_refs\"])] == before[\"reviews\"][0][\"assertion_refs\"]\nchanged=subprocess.check_output([\"git\",\"diff\",\"--name-only\"],text=True).splitlines()\nassert not any(p.startswith((\"planning-mds/features/\",\"engine/\",\"experience/\",\"neuron/\")) for p in changed)\nsubprocess.run([\"git\",\"diff\",\"--check\"],check=True)\nrun=Path(\"planning-mds/operations/evidence/runs/2026-10-11-453de556\")\nassert not any((run/p).exists() for p in (\"evidence-manifest.json\",\"latest-run.json\",\"signoff-ledger.md\"))\nprint(\"PASS: prior identity/run/commit records and assertions/slots/facts preserved; exactly four lifecycle records added per group.\")\nprint(\"PASS: no runtime or feature-folder changes; diff whitespace clean; no feature-completion artifacts.\")\n'","exit_code":0,"artifacts":["planning-mds/operations/evidence/runs/2026-10-11-453de556/artifacts/test-results/fidelity-check.txt"],"redactions":[]}
