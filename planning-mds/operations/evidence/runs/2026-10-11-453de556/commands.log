{"schema_version":1,"timestamp":"2026-10-11T23:13:45-04:00","cwd":"{NEBULA_PRODUCT_ROOT}","command":"python3 -c 'import json\nfrom pathlib import Path\np=Path(\"planning-mds/examples/commercial-pc-account/records.json\")\ndata=json.loads(p.read_text())\nlines=[\"{\"]\nitems=list(data.items())\nfor i,(key,value) in enumerate(items):\n    suffix=\",\" if i < len(items)-1 else \"\"\n    if isinstance(value,list):\n        lines.append(\"  \" + json.dumps(key) + \": [\")\n        lines.extend(\"    \"+json.dumps(row,ensure_ascii=False)+(\",\" if j<len(value)-1 else \"\") for j,row in enumerate(value))\n        lines.append(\"  ]\"+suffix)\n    else:\n        lines.append(\"  \"+json.dumps(key)+\": \"+json.dumps(value,ensure_ascii=False)+suffix)\nlines.append(\"}\")\np.write_text(\"\\n\".join(lines)+\"\\n\")\np=Path(\"planning-mds/examples/commercial-pc-account/expected-results.yaml\")\ntext=p.read_text().replace(\"observed_on: '\"'\"'2026-10-10'\"'\"'\", \"observed_on: '\"'\"'2026-10-11'\"'\"'\")\ntext=text.replace(\"    fail and jv-designated-parent conforms.\\n\", \"    fail and jv-designated-parent conforms.\\n    2026-10-11: owned-policy selection is independent of insured roles; dated accountStatus\\n    permits closed-account replacement while rejecting two current accounts. EX-PC-020/021\\n    add 12 passing regression cases; the strict RDF expectations pass on Python 3.12.13\\n    with the tool versions above (run 2026-10-11-453de556).\\n\")\np.write_text(text)\n'","exit_code":0,"artifacts":[],"redactions":[]}
