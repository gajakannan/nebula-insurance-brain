   163	async def current_principal(
   164	    request: Request,
   165	    authorization: str | None = Header(default=None),
   166	    session: AsyncSession = Depends(get_db_session),
   167	    credential_verifier: CredentialVerifier = Depends(get_credential_verifier),
   168	    identity_profile: IdentityProfile = Depends(get_identity_profile),
   169	    authentication_sink: AuthenticationEventSink = Depends(get_authentication_event_sink),
   170	) -> Principal:
   171	    """Verify before any storage read, then resolve the stable principal and commit
   172	    the identity mapping before any protected operation (F0002-S0002)."""
   173	    if not authorization or not authorization.startswith("Bearer "):
   174	        raise await _reject(request, authentication_sink, "malformed")
   175	    token = authorization.removeprefix("Bearer ")
   176	    try:
   177	        credential = await credential_verifier.verify(token)
   178	    except CredentialError as exc:
   179	        raise await _reject(request, authentication_sink, exc.code) from exc
   180	    resolver = PrincipalResolver(SqlAlchemyIdentityRepository(session), identity_profile)
   181	    try:
   182	        principal = await resolver.resolve(credential)
   183	        await session.commit()
   184	    except CredentialError as exc:
   185	        await session.rollback()
   186	        raise await _reject(request, authentication_sink, exc.code) from exc
   187	    except SQLAlchemyError as exc:
   188	        await session.rollback()
   189	        raise ServiceUnavailableError() from exc
   190	    return principal
   191	
   192	
   193	async def get_authorization_execution(
   194	    session: AsyncSession = Depends(get_db_session),
   195	    casbin_adapter: CasbinAuthorizationAdapter = Depends(get_casbin_adapter),
   196	) -> AuthorizationExecution:
   197	    """Composes the shared evaluator, current-state store, clock and policy release
   198	    over the request's unit of work. No caller-assembled membership snapshot."""
   199	    return AuthorizationExecution(
   200	        SqlAlchemyAuthorityStore(session), casbin_adapter, casbin_adapter.release
   201	    )
