   139	async def _reject(
   140	    request: Request, sink: AuthenticationEventSink, reason_code: str
   141	) -> UnauthenticatedError:
   142	    """Durably record the rejected credential (no principal or resource lookup), then
   143	    return the generic 401. If the event cannot be persisted, the caller gets a
   144	    sanitized 503 instead and no protected operation runs."""
   145	    trace_id = new_trace_id()
   146	    _record_credential_failure(request, reason_code, trace_id)
   147	    try:
   148	        await sink.record(
   149	            AuthenticationEvent(
   150	                event_id=uuid4(),
   151	                occurred_at=datetime.now(UTC),
   152	                reason_code=AuthenticationReason(reason_code),
   153	                route_template=_route_template(request),
   154	                trace_id=trace_id,
   155	            )
   156	        )
   157	    except Exception as exc:  # noqa: BLE001 - any sink failure is an availability failure
   158	        logger.error("authentication_event_unavailable", extra={"reason_code": reason_code})
   159	        raise ServiceUnavailableError() from exc
   160	    return UnauthenticatedError(reason_code)
