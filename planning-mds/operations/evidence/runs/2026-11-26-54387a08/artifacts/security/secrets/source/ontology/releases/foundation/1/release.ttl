@prefix nebula: <urn:nebula:vocab:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<ontrel:sha256-3602b71f33d5283747e4545ccdc261ba1c3bfdf791a2893c9458b805011106c0> rdf:type owl:Ontology ;
    owl:versionInfo "foundation@1" .

<urn:nebula:ont:foundation.account> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.role-scope> ;
    skos:definition "The carrier's customer relationship with exactly one insured or prospective insured organization, with at most one designated parent account."@en-US ;
    skos:prefLabel "Account"@en-US .

<urn:nebula:ont:foundation.account-status> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.thing> ;
    skos:definition "The lifecycle state of an account in the teaching vocabulary: CURRENT means not closed."@en-US ;
    skos:prefLabel "Account status"@en-US .

<urn:nebula:ont:foundation.account-status.closed> rdf:type owl:NamedIndividual ;
    rdf:type <urn:nebula:ont:foundation.account-status> ;
    skos:definition "Account status CLOSED in the teaching vocabulary (ADR-0070 section 2)."@en-US ;
    skos:prefLabel "Closed"@en-US .

<urn:nebula:ont:foundation.account-status.current> rdf:type owl:NamedIndividual ;
    rdf:type <urn:nebula:ont:foundation.account-status> ;
    skos:definition "Account status CURRENT in the teaching vocabulary (ADR-0070 section 2)."@en-US ;
    skos:prefLabel "Current"@en-US .

<urn:nebula:ont:foundation.account.organization> rdf:type owl:ObjectProperty ;
    skos:definition "The one organization the account is the customer relationship with; the link never changes."@en-US ;
    skos:prefLabel "Account organization"@en-US ;
    nebula:predicateKey "fnd:accountOrganization@v1" ;
    nebula:temporalKind "ETERNAL" ;
    nebula:validationDomain <urn:nebula:ont:foundation.account> ;
    nebula:validationRange <urn:nebula:ont:foundation.organization> .

<urn:nebula:ont:foundation.account.parent-account> rdf:type owl:ObjectProperty ;
    skos:definition "The account designated as this account's parent for roll-up; never computed from ownership."@en-US ;
    skos:prefLabel "Parent account"@en-US ;
    nebula:predicateKey "fnd:parentAccount@v1" ;
    nebula:temporalKind "STATE" ;
    nebula:validationDomain <urn:nebula:ont:foundation.account> ;
    nebula:validationRange <urn:nebula:ont:foundation.account> .

<urn:nebula:ont:foundation.account.status> rdf:type owl:ObjectProperty ;
    skos:definition "The account's lifecycle status at a valid and known time; unknown status is incomplete, not closed."@en-US ;
    skos:prefLabel "Account status"@en-US ;
    nebula:predicateKey "fnd:accountStatus@v1" ;
    nebula:temporalKind "STATE" ;
    nebula:validationDomain <urn:nebula:ont:foundation.account> ;
    nebula:validationRange <urn:nebula:ont:foundation.account-status> .

<urn:nebula:ont:foundation.agreement> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.thing> ;
    skos:definition "A binding arrangement between parties; insurance policies and programs are agreements defined by insurance modules."@en-US ;
    skos:prefLabel "Agreement"@en-US .

<urn:nebula:ont:foundation.amount> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.thing> ;
    skos:definition "A quantity with a unit or currency; money is an amount with a currency and a basis."@en-US ;
    skos:prefLabel "Amount"@en-US .

<urn:nebula:ont:foundation.decision> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.thing> ;
    skos:definition "An attributable choice made by a party or principal under stated authority."@en-US ;
    skos:prefLabel "Decision"@en-US .

<urn:nebula:ont:foundation.document> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.thing> ;
    skos:definition "A source document whose versions are parsed once and retained as immutable evidence."@en-US ;
    skos:prefLabel "Document"@en-US .

<urn:nebula:ont:foundation.event> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.thing> ;
    skos:definition "Something that happens at a point in time at its stated granularity."@en-US ;
    skos:prefLabel "Event"@en-US .

<urn:nebula:ont:foundation.identifier> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.thing> ;
    skos:definition "A value that identifies a thing within a named issuing scheme."@en-US ;
    skos:prefLabel "Identifier"@en-US .

<urn:nebula:ont:foundation.measurement> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.thing> ;
    skos:definition "An observed or reported quantity with its unit, method and observation time."@en-US ;
    skos:prefLabel "Measurement"@en-US .

<urn:nebula:ont:foundation.organization> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.party> ;
    skos:definition "An identified organization. Broker, carrier, MGA and insured are roles it plays in a scope, not kinds of organization."@en-US ;
    skos:prefLabel "Organization"@en-US .

<urn:nebula:ont:foundation.organization.child-organization> rdf:type owl:ObjectProperty ;
    owl:inverseOf <urn:nebula:ont:foundation.organization.parent-organization> ;
    skos:definition "Inverse of parent organization; derived, never stored as a slot."@en-US ;
    skos:prefLabel "Child organization"@en-US ;
    nebula:temporalKind "STATE" ;
    nebula:validationDomain <urn:nebula:ont:foundation.organization> ;
    nebula:validationRange <urn:nebula:ont:foundation.organization> .

<urn:nebula:ont:foundation.organization.operates-at> rdf:type owl:ObjectProperty ;
    skos:definition "A place at which the organization operates during the valid period."@en-US ;
    skos:prefLabel "Operates at"@en-US ;
    nebula:predicateKey "fnd:operatesAt@v1" ;
    nebula:temporalKind "STATE" ;
    nebula:validationDomain <urn:nebula:ont:foundation.organization> ;
    nebula:validationRange <urn:nebula:ont:foundation.place> .

<urn:nebula:ont:foundation.organization.parent-organization> rdf:type owl:ObjectProperty ;
    skos:definition "The organization directly above this one in its hierarchy; the hierarchy has no fixed depth."@en-US ;
    skos:prefLabel "Parent organization"@en-US ;
    nebula:predicateKey "fnd:parentOrganization@v1" ;
    nebula:temporalKind "STATE" ;
    nebula:validationDomain <urn:nebula:ont:foundation.organization> ;
    nebula:validationRange <urn:nebula:ont:foundation.organization> .

<urn:nebula:ont:foundation.ownership-interest> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.thing> ;
    skos:definition "A recorded ownership of one organization by a party with a percentage; majority is computed, never stored."@en-US ;
    skos:prefLabel "Ownership interest"@en-US .

<urn:nebula:ont:foundation.ownership-interest.owned-organization> rdf:type owl:ObjectProperty ;
    skos:definition "The organization the ownership interest is in."@en-US ;
    skos:prefLabel "Owned organization"@en-US ;
    nebula:predicateKey "fnd:ownershipOwnedOrganization@v1" ;
    nebula:temporalKind "ETERNAL" ;
    nebula:validationDomain <urn:nebula:ont:foundation.ownership-interest> ;
    nebula:validationRange <urn:nebula:ont:foundation.organization> .

<urn:nebula:ont:foundation.ownership-interest.owner> rdf:type owl:ObjectProperty ;
    skos:definition "The party holding the ownership interest."@en-US ;
    skos:prefLabel "Owner"@en-US ;
    nebula:predicateKey "fnd:ownershipOwner@v1" ;
    nebula:temporalKind "ETERNAL" ;
    nebula:validationDomain <urn:nebula:ont:foundation.ownership-interest> ;
    nebula:validationRange <urn:nebula:ont:foundation.party> .

<urn:nebula:ont:foundation.ownership-interest.percentage> rdf:type owl:DatatypeProperty ;
    skos:definition "The recorded percentage of the owned organization held, greater than 0 and at most 100."@en-US ;
    skos:prefLabel "Ownership percentage"@en-US ;
    nebula:predicateKey "fnd:ownershipPercentage@v1" ;
    nebula:temporalKind "STATE" ;
    nebula:validationDomain <urn:nebula:ont:foundation.ownership-interest> ;
    nebula:validationRange xsd:decimal .

<urn:nebula:ont:foundation.party> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.thing> ;
    skos:definition "A person or an organization capable of participating in a scoped insurance relationship."@en-US ;
    skos:prefLabel "Party"@en-US .

<urn:nebula:ont:foundation.person> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.party> ;
    skos:definition "An individual human party; a role played in insurance does not make the person an application principal."@en-US ;
    skos:prefLabel "Person"@en-US .

<urn:nebula:ont:foundation.person.employed-by> rdf:type owl:ObjectProperty ;
    skos:definition "The organization or branch that employs the person; separate from any role the person plays."@en-US ;
    skos:prefLabel "Employed by"@en-US ;
    nebula:predicateKey "fnd:employedBy@v1" ;
    nebula:temporalKind "STATE" ;
    nebula:validationDomain <urn:nebula:ont:foundation.person> ;
    nebula:validationRange <urn:nebula:ont:foundation.organization> .

<urn:nebula:ont:foundation.place> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.thing> ;
    skos:definition "A location such as an office, premises or yard at which an organization operates; operating there does not make it insured property."@en-US ;
    skos:prefLabel "Place"@en-US .

<urn:nebula:ont:foundation.process> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.thing> ;
    skos:definition "A sequence of activities with lifecycle states, defined in detail by later process modules."@en-US ;
    skos:prefLabel "Process"@en-US .

<urn:nebula:ont:foundation.role> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.thing> ;
    skos:definition "A function a party performs within a scope; roles describe who does what and grant nothing by themselves."@en-US ;
    skos:prefLabel "Role"@en-US .

<urn:nebula:ont:foundation.role-assignment> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.role> ;
    skos:definition "A party playing a role kind in a scope, optionally acting for an organization, valid over a period."@en-US ;
    skos:prefLabel "Role assignment"@en-US .

<urn:nebula:ont:foundation.role-assignment.acted-for> rdf:type owl:ObjectProperty ;
    skos:definition "The organization or branch a person represents in this role."@en-US ;
    skos:prefLabel "Acted for"@en-US ;
    nebula:predicateKey "fnd:roleActedFor@v1" ;
    nebula:temporalKind "STATE" ;
    nebula:validationDomain <urn:nebula:ont:foundation.role-assignment> ;
    nebula:validationRange <urn:nebula:ont:foundation.organization> .

<urn:nebula:ont:foundation.role-assignment.authoritative-source> rdf:type owl:DatatypeProperty ;
    skos:definition "The trusted source that confirmed the assignment; data only, it grants nothing."@en-US ;
    skos:prefLabel "Authoritative source"@en-US ;
    nebula:predicateKey "fnd:roleAuthoritativeSource@v1" ;
    nebula:temporalKind "STATE" ;
    nebula:validationDomain <urn:nebula:ont:foundation.role-assignment> ;
    nebula:validationRange xsd:string .

<urn:nebula:ont:foundation.role-assignment.coverage-part> rdf:type owl:ObjectProperty ;
    skos:definition "A coverage part of a policy term that narrows a policy-term role; insurance modules narrow the range."@en-US ;
    skos:prefLabel "Coverage part"@en-US ;
    nebula:predicateKey "fnd:roleCoveragePart@v1" ;
    nebula:temporalKind "STATE" ;
    nebula:validationDomain <urn:nebula:ont:foundation.role-assignment> ;
    nebula:validationRange <urn:nebula:ont:foundation.thing> .

<urn:nebula:ont:foundation.role-assignment.party> rdf:type owl:ObjectProperty ;
    skos:definition "The party filling the role during the valid period."@en-US ;
    skos:prefLabel "Party in role"@en-US ;
    nebula:predicateKey "fnd:roleParty@v1" ;
    nebula:temporalKind "STATE" ;
    nebula:validationDomain <urn:nebula:ont:foundation.role-assignment> ;
    nebula:validationRange <urn:nebula:ont:foundation.party> .

<urn:nebula:ont:foundation.role-assignment.role-kind> rdf:type owl:ObjectProperty ;
    skos:definition "The kind of role assigned; fixed for the life of the assignment."@en-US ;
    skos:prefLabel "Role kind"@en-US ;
    nebula:predicateKey "fnd:roleKind@v1" ;
    nebula:temporalKind "ETERNAL" ;
    nebula:validationDomain <urn:nebula:ont:foundation.role-assignment> ;
    nebula:validationRange <urn:nebula:ont:foundation.role-kind> .

<urn:nebula:ont:foundation.role-assignment.scope> rdf:type owl:ObjectProperty ;
    skos:definition "The account, policy term or submission the assignment applies to; fixed for the life of the assignment."@en-US ;
    skos:prefLabel "Role scope"@en-US ;
    nebula:predicateKey "fnd:roleScope@v1" ;
    nebula:temporalKind "ETERNAL" ;
    nebula:validationDomain <urn:nebula:ont:foundation.role-assignment> ;
    nebula:validationRange <urn:nebula:ont:foundation.role-scope> .

<urn:nebula:ont:foundation.role-kind> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.thing> ;
    skos:definition "The open vocabulary of role kinds a role assignment can name."@en-US ;
    skos:prefLabel "Role kind"@en-US .

<urn:nebula:ont:foundation.role-kind.account-contact> rdf:type owl:NamedIndividual ;
    rdf:type <urn:nebula:ont:foundation.role-kind> ;
    skos:definition "The account contact role kind (ADR-0070 section 4); confers no access by itself."@en-US ;
    skos:prefLabel "Account contact"@en-US ;
    nebula:externalCode "PartyRoleTypeCode=ACCOUNT_CONTACT" ;
    nebula:externalCode "PartyRoleTypeCode_status=proposed" .

<urn:nebula:ont:foundation.role-kind.additional-insured> rdf:type owl:NamedIndividual ;
    rdf:type <urn:nebula:ont:foundation.role-kind> ;
    skos:definition "The additional insured role kind (ADR-0070 section 4); confers no access by itself."@en-US ;
    skos:prefLabel "Additional insured"@en-US ;
    nebula:externalCode "PartyRoleTypeCode=ADDITIONAL_INSURED" ;
    nebula:externalCode "PartyRoleTypeCode_status=existing" .

<urn:nebula:ont:foundation.role-kind.additional-named-insured> rdf:type owl:NamedIndividual ;
    rdf:type <urn:nebula:ont:foundation.role-kind> ;
    skos:definition "The additional named insured role kind (ADR-0070 section 4); confers no access by itself."@en-US ;
    skos:prefLabel "Additional named insured"@en-US ;
    nebula:externalCode "PartyRoleTypeCode=ADDITIONAL_NAMED_INSURED" ;
    nebula:externalCode "PartyRoleTypeCode_status=proposed" .

<urn:nebula:ont:foundation.role-kind.broker-contact> rdf:type owl:NamedIndividual ;
    rdf:type <urn:nebula:ont:foundation.role-kind> ;
    skos:definition "The broker contact role kind (ADR-0070 section 4); confers no access by itself."@en-US ;
    skos:prefLabel "Broker contact"@en-US ;
    nebula:externalCode "PartyRoleTypeCode=BROKER_CONTACT" ;
    nebula:externalCode "PartyRoleTypeCode_status=proposed" .

<urn:nebula:ont:foundation.role-kind.broker-of-record> rdf:type owl:NamedIndividual ;
    rdf:type <urn:nebula:ont:foundation.role-kind> ;
    skos:definition "The broker of record role kind (ADR-0070 section 4); confers no access by itself."@en-US ;
    skos:prefLabel "Broker of record"@en-US ;
    nebula:externalCode "PartyRoleTypeCode=BROKER_OF_RECORD" ;
    nebula:externalCode "PartyRoleTypeCode_status=existing" .

<urn:nebula:ont:foundation.role-kind.distribution-contact> rdf:type owl:NamedIndividual ;
    rdf:type <urn:nebula:ont:foundation.role-kind> ;
    skos:definition "The distribution contact role kind (ADR-0070 section 4); confers no access by itself."@en-US ;
    skos:prefLabel "Distribution contact"@en-US ;
    nebula:externalCode "PartyRoleTypeCode_status=unmapped" .

<urn:nebula:ont:foundation.role-kind.first-named-insured> rdf:type owl:NamedIndividual ;
    rdf:type <urn:nebula:ont:foundation.role-kind> ;
    skos:definition "The first named insured role kind (ADR-0070 section 4); confers no access by itself."@en-US ;
    skos:prefLabel "First named insured"@en-US ;
    nebula:externalCode "PartyRoleTypeCode=FIRST_NAMED_INSURED" ;
    nebula:externalCode "PartyRoleTypeCode_status=proposed" .

<urn:nebula:ont:foundation.role-kind.marketing-representative> rdf:type owl:NamedIndividual ;
    rdf:type <urn:nebula:ont:foundation.role-kind> ;
    skos:definition "The marketing representative role kind (ADR-0070 section 4); confers no access by itself."@en-US ;
    skos:prefLabel "Marketing representative"@en-US ;
    nebula:externalCode "PartyRoleTypeCode_status=unmapped" .

<urn:nebula:ont:foundation.role-kind.operations-contact> rdf:type owl:NamedIndividual ;
    rdf:type <urn:nebula:ont:foundation.role-kind> ;
    skos:definition "The operations contact role kind (ADR-0070 section 4); confers no access by itself."@en-US ;
    skos:prefLabel "Operations contact"@en-US ;
    nebula:externalCode "PartyRoleTypeCode_status=unmapped" .

<urn:nebula:ont:foundation.role-kind.organization-contact> rdf:type owl:NamedIndividual ;
    rdf:type <urn:nebula:ont:foundation.role-kind> ;
    skos:definition "The organization contact role kind (ADR-0070 section 4); confers no access by itself."@en-US ;
    skos:prefLabel "Organization contact"@en-US ;
    nebula:externalCode "PartyRoleTypeCode_status=unmapped" .

<urn:nebula:ont:foundation.role-kind.placement-broker> rdf:type owl:NamedIndividual ;
    rdf:type <urn:nebula:ont:foundation.role-kind> ;
    skos:definition "The placement broker role kind (ADR-0070 section 4); confers no access by itself."@en-US ;
    skos:prefLabel "Placement broker"@en-US ;
    nebula:externalCode "PartyRoleTypeCode=PLACEMENT_BROKER" ;
    nebula:externalCode "PartyRoleTypeCode_status=proposed" .

<urn:nebula:ont:foundation.role-kind.risk-manager> rdf:type owl:NamedIndividual ;
    rdf:type <urn:nebula:ont:foundation.role-kind> ;
    skos:definition "The risk manager role kind (ADR-0070 section 4); confers no access by itself."@en-US ;
    skos:prefLabel "Risk manager"@en-US ;
    nebula:externalCode "PartyRoleTypeCode=RISK_MANAGER" ;
    nebula:externalCode "PartyRoleTypeCode_status=proposed" .

<urn:nebula:ont:foundation.role-kind.underwriter> rdf:type owl:NamedIndividual ;
    rdf:type <urn:nebula:ont:foundation.role-kind> ;
    skos:definition "The underwriter role kind (ADR-0070 section 4); confers no access by itself."@en-US ;
    skos:prefLabel "Underwriter"@en-US ;
    nebula:externalCode "PartyRoleTypeCode=UNDERWRITER" ;
    nebula:externalCode "PartyRoleTypeCode_status=proposed" .

<urn:nebula:ont:foundation.role-kind.underwriting-assistant> rdf:type owl:NamedIndividual ;
    rdf:type <urn:nebula:ont:foundation.role-kind> ;
    skos:definition "The underwriting assistant role kind (ADR-0070 section 4); confers no access by itself."@en-US ;
    skos:prefLabel "Underwriting assistant"@en-US ;
    nebula:externalCode "PartyRoleTypeCode_status=unmapped" .

<urn:nebula:ont:foundation.role-scope> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.thing> ;
    skos:definition "The thing a role assignment applies to. Account is a role scope; insurance modules add policy-term and submission scopes."@en-US ;
    skos:prefLabel "Role scope"@en-US .

<urn:nebula:ont:foundation.thing> rdf:type owl:Class ;
    skos:definition "The root of every foundation class; anything the Brain can describe with evidence."@en-US ;
    skos:prefLabel "Thing"@en-US .

<urn:nebula:ont:foundation.time-interval> rdf:type owl:Class ;
    rdfs:subClassOf <urn:nebula:ont:foundation.thing> ;
    skos:definition "A span of time with a start and an end bound at stated granularities."@en-US ;
    skos:prefLabel "Time interval"@en-US .
