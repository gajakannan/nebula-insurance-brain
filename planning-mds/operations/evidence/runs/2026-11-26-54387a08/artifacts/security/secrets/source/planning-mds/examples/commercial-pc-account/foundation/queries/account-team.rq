PREFIX fnd: <urn:nebula:ont:foundation.>
PREFIX d: <https://example.invalid/nebula/data/>
# EX-PC-017, account-scoped rows on foundation IRIs: who does what on the accounts of the Holdings
# hierarchy. Policy-term and submission scopes are F0013's (EX-PC-018/019). Roles grant nothing (EX-PC-011).
SELECT DISTINCT ?person ?role ?scope ?actsFor WHERE {
  ?assignment fnd:role-assignment.party ?person ; fnd:role-assignment.role-kind ?role ;
              fnd:role-assignment.scope ?scope ; fnd:role-assignment.acted-for ?actsFor .
  ?person a fnd:person .
  ?scope fnd:account.parent-account* d:EX-PC-ACCOUNT .
} ORDER BY ?person ?scope
