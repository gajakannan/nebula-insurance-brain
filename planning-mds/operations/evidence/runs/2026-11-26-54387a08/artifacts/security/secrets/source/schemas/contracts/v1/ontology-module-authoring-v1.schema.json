{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebula.local/schemas/ontology-module-authoring-v1.schema.json",
  "title": "Ontology module authoring v1",
  "description": "Design schema for one authored ontology module file (ADR-0081 D1/D2). Singular `parent` is intentionally absent; the validator reports it as AUTHORING_FIELD_RETIRED before schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authoring_schema",
    "module",
    "terms"
  ],
  "properties": {
    "authoring_schema": {
      "const": "ontology-module-authoring/v1"
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "predicate_namespace",
        "dependencies"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "predicate_namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}@[1-9][0-9]*#sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/term"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "projection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projection_rule"
      }
    }
  },
  "$defs": {
    "labels": {
      "type": "object",
      "required": [
        "en-US"
      ],
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "labels",
        "definition",
        "examples",
        "regression_cases"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}(\\.[a-z][a-z0-9-]{0,47}){1,7}$"
        },
        "kind": {
          "enum": [
            "class",
            "object_property",
            "datatype_property",
            "code_value"
          ]
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "value"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "definition": {
          "type": "string",
          "minLength": 20
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "regression_cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "parents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}(\\.[a-z][a-z0-9-]{0,47}){1,7}$"
          }
        },
        "domain": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}(\\.[a-z][a-z0-9-]{0,47}){1,7}$"
        },
        "range": {
          "type": "string",
          "minLength": 1
        },
        "inverse_of": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}(\\.[a-z][a-z0-9-]{0,47}){1,7}$"
        },
        "sub_property_of": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}(\\.[a-z][a-z0-9-]{0,47}){1,7}$"
          }
        },
        "temporal_kind": {
          "enum": [
            "STATE",
            "EVENT",
            "ETERNAL"
          ]
        },
        "value_type": {
          "enum": [
            "text",
            "code",
            "decimal",
            "date",
            "boolean",
            "entity_ref",
            "money",
            "identifier",
            "name"
          ]
        },
        "cardinality": {
          "enum": [
            "SINGLE",
            "MULTI",
            "RELATIONSHIP"
          ]
        },
        "predicate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "local_name",
            "major"
          ],
          "properties": {
            "local_name": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$"
            },
            "major": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            }
          }
        },
        "code_of": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}(\\.[a-z][a-z0-9-]{0,47}){1,7}$"
        },
        "external_codes": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "object_property",
                  "datatype_property"
                ]
              }
            }
          },
          "then": {
            "required": [
              "domain",
              "range",
              "temporal_kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "class"
              }
            }
          },
          "then": {
            "required": [
              "parents"
            ]
          }
        },
        {
          "if": {
            "required": [
              "predicate"
            ]
          },
          "then": {
            "required": [
              "value_type",
              "cardinality"
            ]
          }
        }
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "construct",
        "subject",
        "stage",
        "consumer",
        "applicability",
        "severity",
        "on_nonconformance",
        "data_basis"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}(\\.[a-z][a-z0-9-]{0,47}){1,7}$"
        },
        "construct": {
          "enum": [
            "domain",
            "range",
            "disjoint",
            "minCardinality",
            "maxCardinality",
            "custom"
          ]
        },
        "subject": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}(\\.[a-z][a-z0-9-]{0,47}){1,7}$"
        },
        "property": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}(\\.[a-z][a-z0-9-]{0,47}){1,7}$"
        },
        "with": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}(\\.[a-z][a-z0-9-]{0,47}){1,7}$"
          }
        },
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "expression": {
          "type": "string",
          "description": "Natural-language statement of a custom constraint; executed only by its named consumer."
        },
        "stage": {
          "enum": [
            "authoring",
            "canonical-admission",
            "example-validation",
            "assessment-preconditions",
            "consumer-defined"
          ]
        },
        "consumer": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "violation",
            "warning"
          ]
        },
        "on_nonconformance": {
          "type": "string",
          "minLength": 1
        },
        "data_basis": {
          "oneOf": [
            {
              "const": "asserted"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "inferred"
              ],
              "properties": {
                "inferred": {
                  "const": "nebula-tbox-subset/v1"
                }
              }
            }
          ]
        }
      }
    },
    "projection_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property",
        "disposition"
      ],
      "properties": {
        "property": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}(\\.[a-z][a-z0-9-]{0,47}){1,7}$"
        },
        "disposition": {
          "enum": [
            "edge",
            "vertex_property",
            "omitted"
          ]
        },
        "label": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        },
        "direction": {
          "const": "subject-to-object"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "omitted"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          },
          "else": {
            "required": [
              "label"
            ]
          }
        }
      ]
    }
  }
}
