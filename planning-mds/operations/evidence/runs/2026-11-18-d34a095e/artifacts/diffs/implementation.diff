+
+
+async def test_s0006_ac5_read_returns_every_field_and_keeps_pilot_names(world):
+    w = world
+    slot = await _section_87(w)
+    body = (await w.read(slot, "2026-05-15T12:00:00Z", NOW)).json()
+    for pilot in (
+        "id",
+        "fact_slot_id",
+        "value",
+        "valid_start",
+        "valid_end",
+        "recorded_start",
+        "recorded_end",
+        "change_reason",
+        "evidence_refs",
+        "commit_id",
+        "canonical_accepted_at",
