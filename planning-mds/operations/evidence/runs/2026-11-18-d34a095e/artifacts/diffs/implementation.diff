+
+
+async def test_s0006_ac6_default_coordinates_and_malformed_ones(world):
+    w = world
+    slot = await w.slot()
+    assert (
+        await w.commit_v1(slot, money("9"), start=bound("2026-01-01T06:00:00Z"))
+    ).status_code == 201
+    assert amount(await w.read(slot)) == "9"  # both default to now
