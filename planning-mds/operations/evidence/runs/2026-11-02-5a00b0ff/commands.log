{"schema_version":1,"timestamp":"2026-11-03T21:50:47-05:00","cwd":"{NEBULA_PRODUCT_ROOT}","command":"python3 -c 'from pathlib import Path\nimport yaml,json\np=Path(\"/home/gajap/uSandbox/repos/nebula/nebula-insurance-brain\");run=p/\"planning-mds/operations/evidence/runs/2026-11-02-5a00b0ff\"\nchanged=[]\ndef load(name):return yaml.safe_load((p/name).read_text())\ndef write(name,data):\n f=p/name;old=f.read_text();head=[]\n for line in old.splitlines():\n  if line.startswith(\"#\"):head.append(line)\n  elif line.strip():break\n text=(\"\\n\".join(head)+\"\\n\" if head else \"\")+yaml.safe_dump(data,sort_keys=False,allow_unicode=True,width=105)\n if text!=old:f.write_text(text);changed.append(name)\ndef addpaths(record,bucket,items):\n values=record.setdefault(\"paths\",{}).setdefault(bucket,[])\n for item in items:\n  if item not in values:values.append(item)\nname=\"planning-mds/kg-source/bindings/f0006-planning.yaml\";data=load(name);by={x[\"id\"]:x for x in data[\"bindings\"]}\nfor record in by.values():\n for bucket in list(record[\"paths\"]):\n  record[\"paths\"][bucket]=[x for x in record[\"paths\"][bucket] if not x.startswith(\"planning-mds/features/F0006-\")]\n  if not record[\"paths\"][bucket]:del record[\"paths\"][bucket]\nversion=by[\"capability:versioned-assertion-semantics\"]\naddpaths(version,\"backend\",[\n \"engine/packages/brain-contracts/src/brain_contracts/assertions.py\",\"engine/packages/brain-contracts/src/brain_contracts/dispatch.py\",\n \"engine/packages/brain-domain/src/brain_domain/assertions.py\",\"engine/packages/brain-persistence/src/brain_persistence/assertion_models.py\",\n \"engine/packages/brain-persistence/src/brain_persistence/assertions.py\",\"engine/packages/brain-persistence/src/brain_persistence/models.py\",\n \"engine/migrations/versions/0011_f0006_assertion_semantics.py\"])\naddpaths(version,\"schemas\",[\"engine/packages/brain-contracts/src/brain_contracts/schemas/\"+x+\".schema.json\" for x in [\"assertion-record-v2\",\"int