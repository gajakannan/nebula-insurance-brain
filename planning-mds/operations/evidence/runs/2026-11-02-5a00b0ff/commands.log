index[\"node_bindings\"];patterns=[]\ndef walk(value):\n if isinstance(value,dict):\n  for x in value.values():yield from walk(x)\n elif isinstance(value,list):\n  for x in value:\n   if isinstance(x,str):yield x\n   else:yield from walk(x)\nfor b in bindings:\n for pattern in walk(b.get(\"paths\",{})):patterns.append((b[\"id\"],pattern))\nresolved={}\nfor node,pattern in patterns:\n for file in expand_declared_pattern(pattern):resolved.setdefault(file,[]).append(node)\nm=json.loads((run/\"evidence-manifest.json\").read_text())\nsources=[x for x in m[\"changed_paths\"] if x.startswith((\"engine/\",\"neuron/\"))]\nrows=[{\"path\":x,\"nodes\":sorted(set(resolved.get(x,[])))} for x in sources]\nmissing=[x[\"path\"] for x in rows if not x[\"nodes\"]]\n# The generated source can use a mapping envelope in older toolchain versions.\nassert not missing,missing\ninv=json.loads((run/\"artifacts/coverage/changed-production-lines.json\").read_text())\nassert all(hashlib.sha256((p/x[\"path\"]).read_bytes()).hexdigest()==x[\"sha256\"] for x in inv)\naudit={\"source_path_count\":len(rows),\"production_python_count\":len(inv),\"production_hashes_match\":True,\"unbound_paths\":missing,\"paths\":rows,\"node_triage_counts\":v[\"node_counts\"],\"disposition_counts\":dict(groups)}\n(run/\"artifacts/test-results/g7-binding-coverage.json\").write_text(json.dumps(audit,indent=2)+\"\\n\")\nprint(\"Triage\",len(v[\"symbols\"]),\"symbols across20nodes:\",dict(groups))\nprint(\"All\",len(rows),\"runtime/test/resource paths bound;20productionhashesmatch.\")\n'","exit_code":0,"artifacts":[],"redactions":[]}
