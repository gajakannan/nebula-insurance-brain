aths(by[node],\"backend\",[\"engine/packages/brain-persistence/src/brain_persistence/assertion_models.py\",\"engine/packages/brain-persistence/src/brain_persistence/assertions.py\",\"engine/migrations/versions/0011_f0006_assertion_semantics.py\"])\n addpaths(by[node],\"tests\",[\"engine/tests/integration/test_assertion_admission.py\",\"engine/tests/integration/test_assertion_migration.py\",\"engine/tests/integration/test_assertion_ownership.py\"])\ndata[\"bindings\"].append({\"id\":\"entity:assertion\",\"paths\":{\"backend\":[\"engine/packages/brain-domain/src/brain_domain/assertions.py\",\"engine/packages/brain-persistence/src/brain_persistence/models.py\",\"engine/packages/brain-persistence/src/brain_persistence/assertions.py\"],\"tests\":[\"engine/tests/integration/test_assertion_admission.py\",\"engine/tests/integration/test_assertion_consumers.py\",\"engine/tests/integration/test_assertion_migration.py\"]}})\nwrite(name,data)\nname=\"planning-mds/kg-source/bindings/f0002.yaml\";data=load(name);by={x[\"id\"]:x for x in data[\"bindings\"]}\naddpaths(by[\"capability:durable-authorization-decisions\"],\"backend\",[\"engine/apps/api/src/brain_api/routes/facts.py\",\"engine/apps/api/src/brain_api/routes/reviews.py\",\"engine/packages/brain-assertions/src/brain_assertions/service.py\"])\naddpaths(by[\"capability:durable-authorization-decisions\"],\"tests\",[\"engine/packages/brain-security/tests/test_execution.py\"])\nwrite(name,data)\nname=\"planning-mds/kg-source/bindings/f0001.yaml\";data=load(name);by={x[\"id\"]:x for x in data[\"bindings\"]}\naddpaths(by[\"capability:semantic-interpretation-run\"],\"tests\",[\"engine/packages/brain-assertions/tests/test_contracts.py\"])\naddpaths(by[\"capability:evidence-review-round-trip\"],\"tests\",[\"engine/packages/brain-review/tests/**\",\"engine/apps/api/tests/test_reviews.py\"])\naddpaths(by[\"capability:bitemporal-canonical-commit\"],\"tests\",[\"engine/packages/brain-temporal/tests/**\",\"engine/apps/api/tests/test_facts.py\"])\nwrite(name,data)\nnotes={\n\"capabilities/versioned-assertion-semantics\":\"Implemented for F0006 run2026-11-02-5a00b0ff: strict typed/open contracts, explicit version dispatch, independent dimensions and immutable semantic extensions. Legacy source rows and v1-only importer/defaults are preserved. Qualified synthetic fixture proof does not activate a live producer or grant canonical acceptance; ADR0075 remains Proposed.\",\n\"capabilities/structural-assertion-admission\":\"Implemented for F0006 run2026-11-02-5a00b0ff: authorized deterministic quote/name/time/reference checks with server-derived honest selectors, atomic scoped name ownership and protected per-item outcomes. Admission performs zero model/conversion/canonical writes. F0016 still owns durable drops, time production and full run adoption; native examples are synthetic retained-source proof.\",\n\"capabilities/assertion-eligibility-guards\":\"Implemented for F0006 run2026-11-02-5a00b0ff: conjunctive kind/mood/verified-origin restrictions at existing review/correction and mandatory pilot commit guards. Source discovery projects metadata only; current source READ and same-UoW proof precede protected semantic loading. Basis remains visible with existing policy, not a new compulsory review rule. Legacy unregistered pilot behavior remains explicit; no new grants, auto-acceptance or full F0018 orchestration.\",\n\"entities/assertion\":\"Source claim distinct from canonical truth. F0006 run2026-11-02-5a00b0ff adds versioned typed/open semantics, independent mode/origin/basis, server-grounded evidence and current-consumer eligibility. The legacy carrier remains a compatibility projection; v2 meaning resides in its immutable one-to-one extension. Admission creates no canonical fact and does not activate a producer.\",\n\"entities/assertion-semantics\":\"Implemented immutable one-to-one v2 extension keyed to the existing assertion ID, retaining the complete source record, independent dimensions, verified evidence/source hashes and scoped reference/time snapshots. PostgreSQL deferred integrity mirrors carrier and evidence coordinates, and v2 corrections own their extension/evidence while inheriting basis. It is not a second assertion identity or canonical fact.\",\n\"entities/assertion-document-reference\":\"Implemented document-version-scoped reference declaration with a grounded introducing name and structural tenant/KB keys. Only references used by accepted claims are retained atomically. These local subjects/objects do not create or resolve canonical Entity identity; F0017 owns later identity work.\",\n\"entities/assertion-name-claim\":\"Implemented append-only document-scoped NFC/case/whitespace name ownership, protected by document locking and a scoped unique key. It supplies NAME_CLAIMED_BY_ANOTHER checks with rollback/replay behavior; it is not a canonical name FactSlot or alias projection.\"\n}\nfor rel,note in notes.items():\n name=\"planning-mds/kg-source/nodes/\"+rel+\".yaml\";data=load(name);data[\"notes\"]=note.replace(\"run2026\",\"run 2026\").replace(\"ADR0075\",\"ADR-0075\")\n for rat in data.get(\"rationale\",[]):\n  if rat.get(\"adr\")==\"adr:0075\":rat[\"summary\"]=\"F0006 as-built versioned claims, structural admission and guarded current consumers have source-bound synthetic/PostgreSQL proof; no new producer, canonical acceptance policy or formal Proposed ADR acceptance is implied.\"\n write(name,data)\nname=\"planning-mds/kg-source/nodes/capabilities/durable-authorization-decisions.yaml\";data=load(name)\ndata[\"notes\"]+=\" F0006 extends the same mutation UoW with source READ discovery/recheck/audit for assertion, review and commit consumers; metadata-only discovery precedes protected loads and direct v2 commits require current source proof. No new grants or nested read-facade commit is introduced.\"\nif \"F0006/feature-assembly-plan.md\" not in data[\"source_docs\"]:data[\"source_docs\"].append(\"F0006/feature-assembly-plan.md\")\nwrite(name