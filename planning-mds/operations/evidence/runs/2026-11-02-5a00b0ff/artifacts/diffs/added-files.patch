+            "enum": [
+              "OPEN_STATEMENT",
+              "MOOD",
+              "DESCRIBED_EVIDENCE",
+              "UNRESOLVED_EVIDENCE",
+              "LEGACY_UNQUALIFIED"
+            ]
+          }
+        },
+        "blocked_operations": {
