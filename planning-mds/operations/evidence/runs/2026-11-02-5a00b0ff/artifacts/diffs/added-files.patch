+          "uniqueItems": true,
+          "items": {
+            "type": "string",
+            "enum": [
+              "RESOLVE",
+              "CREATE",
+              "AUTO_ACCEPT",
+              "CLOSE",
+              "SUPERSEDE"
+            ]
+          }
+        },
+        "created_by": {
+          "type": "string",
+          "format": "uuid"
+        },
+        "created_at": {
+          "type": "string",
+          "format": "date-time"
+        }
+      }
+    },
+    "outcome": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "item_index",
+        "item_path",
+        "candidate_id",
+        "block_id",
+        "disposition",
+        "reason",
+        "raw_item_sha256",
+        "excerpt",
+        "model_id",
+        "prompt_hash"
+      ],
+      "properties": {
+        "item_index": {
+          "type": [
+            "integer",
+            "null"
+          ],
+          "minimum": 0
+        },
+        "item_path": {
+          "type": "string",
+          "minLength": 1
+        },
+        "candidate_id": {
+          "anyOf": [
+            {
+              "type": "string",
+              "format": "uuid"
+            },
+            {
+              "type": "null"
+            }
+          ]
+        },
+        "block_id": {
+          "anyOf": [
+            {
+              "type": "string",
+              "minLength": 1
+            },
+            {
+              "type": "null"
+            }
+          ]
+        },
+        "disposition": {
+          "type": "string",
+          "enum": [
+            "REJECTED",
+            "SIGNAL",
+            "RUN_ISSUE"
+          ]
+        },
+        "reason": {
+          "type": "string",
+          "enum": [
+            "QUOTE_NOT_IN_SOURCE",
+            "NAME_NOT_IN_QUOTE",
+            "NAME_CLAIMED_BY_ANOTHER",
+            "TIME_NOT_IN_QUOTE",
+            "UNKNOWN_REFERENCE",
+            "OBJECT_UNDECLARED",
+            "MALFORMED_ITEM",
+            "TRUNCATED_OUTPUT",
+            "BLOCK_UNINTERPRETED"
+          ]
+        },
+        "raw_item_sha256": {
+          "type": "string",
+          "pattern": "^[a-f0-9]{64}$"
+        },
+        "excerpt": {
+          "type": [
+            "string",
+            "null"
+          ]
+        },
+        "model_id": {
+          "type": "string",
+          "minLength": 1
+        },
+        "prompt_hash": {
+          "type": "string",
+          "minLength": 1
+        }
+      },
+      "allOf": [
+        {
+          "if": {
+            "properties": {
+              "reason": {
+                "const": "OBJECT_UNDECLARED"
+              }
+            }
+          },
+          "then": {
+            "properties": {
+              "disposition": {
+                "const": "SIGNAL"
+              }
+            }
+          }
+        }
+      ]
+    }
+  }
+}

