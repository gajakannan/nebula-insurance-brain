+"""Deterministic admission of independently decoded, source-grounded candidates.
+
+The caller must supply trusted source ports inside its existing authorized unit
+of work. Authorization and infrastructure failures propagate; they are never
+misreported as ordinary rejected model items.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Sequence
+from dataclasses import asdict
+from datetime import UTC, datetime
+from hashlib import sha256
+from typing import Any
+from uuid import UUID, uuid5
+
+from brain_contracts.assertions import (
+    NORMALIZATION_VERSION,
+    AdmissionBatch,
+    AdmissionMetadata,
+    AdmissionOutcome,
+    AdmittedAssertion,
+    AssertionContractError,
+    EntityObjectV2,
+    EntityReferenceV2,
+    LiteralObjectV2,
+    ServerEvidence,
+    canonical_json,
+    decode_json,
+    parse_assertion,
+    parse_entity,
+    wire_value,
+)
+from brain_domain.assertions import EntityReference, ProducerContext, VerifiedBlock
+
+from brain_assertions.eligibility import evaluate_eligibility
+from brain_assertions.normalization import locate_quote, normalize
+from brain_assertions.ports import AdmissionSources
+
+
+class AssertionAdmissionService:
+    def __init__(
+        self,
+        sources: AdmissionSources,
+        *,
+        clock: Callable[[], datetime] | None = None,
+    ) -> None:
+        self._sources = sources
+        self._clock = clock or (lambda: datetime.now(UTC))
+
+    async def check_items(
+        self,
+        context: ProducerContext,
+        entities: Sequence[EntityReference],
+        items: Sequence[bytes],
+        *,
+        truncated: bool = False,
+        uninterpreted_blocks: Sequence[str] = (),
+    ) -> AdmissionBatch:
+        declarations: dict[UUID, tuple[int, EntityReferenceV2]] = {}
+        invalid_entities: set[UUID] = set()
+        outcomes: list[AdmissionOutcome] = []
+        accepted: list[AdmittedAssertion] = []
+        blocks: dict[str, VerifiedBlock] = {}
+
+        def outcome(
+            *,
+            index: int | None,
+            path: str,
+            candidate_id: UUID | None,
+            block_id: str | None,
+            reason: str,
+            raw: bytes,
+            disposition: str = "REJECTED",
+            excerpt: str | None = None,
+        ) -> AdmissionOutcome:
+            return AdmissionOutcome(
+                item_index=index,
+                item_path=path,
+                candidate_id=candidate_id,
+                block_id=block_id,
+                disposition=disposition,
+                reason=reason,
+                raw_item_sha256=sha256(raw).hexdigest(),
+                excerpt=excerpt,
+                model_id=context.model_id,
+                prompt_hash=context.prompt_hash,
+            )
+
+        for index, entity in enumerate(entities):
+            try:
+                declaration = parse_entity(entity)
+                if declaration.id in declarations:
+                    invalid_entities.add(declaration.id)
+                    raise AssertionContractError()
+                declarations[declaration.id] = (index, declaration)
+            except (AssertionContractError, TypeError):
+                try:
+                    raw = canonical_json(entity)
+                except AssertionContractError:
+                    raw = b"null"
+                outcomes.append(
+                    outcome(
+                        index=index,
+                        path=f"/entities/{index}",
+                        candidate_id=None,
+                        block_id=None,
+                        reason="MALFORMED_ITEM",
+                        raw=raw,
+                    )
+                )
+
+        async def block(block_id: str) -> VerifiedBlock:
+            if block_id not in blocks:
+                stored = await self._sources.block(context, block_id)
+                # Check identities before inspecting protected source text.
+                if stored.artifact_id != context.artifact_id or stored.block_id != block_id:
+                    raise LookupError("source identity mismatch")
+                blocks[block_id] = stored
+            return blocks[block_id]
+
+        for index, raw in enumerate(items):
+            path = f"/assertions/{index}"
+            try:
+                candidate = parse_assertion(raw)
+            except (AssertionContractError, TypeError):
+                candidate_id = None
+                block_id = None
+                try:
+                    partial = decode_json(raw)
+                    candidate_id = UUID(partial["id"])
+                    supplied = partial.get("evidence", [])
+                    if supplied and isinstance(supplied[0].get("block_id"), str):
+                        block_id = supplied[0]["block_id"] or None
+                except (ValueError, TypeError, KeyError, AttributeError, IndexError):
+                    pass
+                outcomes.append(
+                    outcome(
+                        index=index,
+                        path=path,
+                        candidate_id=candidate_id,
+                        block_id=block_id,
+                        reason="MALFORMED_ITEM",
+                        raw=raw,
+                    )
+                )
+                continue
+
+            item_outcomes: list[AdmissionOutcome] = []
+            evidence: list[ServerEvidence] = []
+            source_hashes: dict[str, str] = {}
+            time_snapshots: list[dict[str, Any]] = []
+            selected: dict[UUID, EntityReferenceV2] = {}
+
+            def fail(
+                reason: str,
+                *,
+                block_id: str | None = None,
+                item_path: str = path,
+                item_index: int = index,
+                identifier: UUID = candidate.id,
+                item_raw: bytes = raw,
+                failures: list[AdmissionOutcome] = item_outcomes,
+            ) -> None:
+                entry = outcome(
+                    index=item_index,
+                    path=item_path,
+                    candidate_id=identifier,
+                    block_id=block_id,
+                    reason=reason,
+                    raw=item_raw,
+                    excerpt=item_raw.decode("utf-8", errors="replace")[:256],
+                )
+                if not any(
+                    (e.reason, e.item_path, e.block_id)
+                    == (entry.reason, entry.item_path, entry.block_id)
+                    for e in failures
+                ):
+                    failures.append(entry)
+
+            if candidate.origin != context.origin:
+                fail("MALFORMED_ITEM")
+            required_refs = [candidate.subject_ref]
+            if (
+                isinstance(candidate.object, EntityObjectV2)
+                and candidate.object.ref in declarations
+            ):
+                required_refs.append(candidate.object.ref)
+            for ref in dict.fromkeys(required_refs):
+                if ref not in declarations or ref in invalid_entities:
+                    fail("UNKNOWN_REFERENCE")
+                    continue
+                entity_index, entity = declarations[ref]
+                selected[ref] = entity
+                entity_path = f"/entities/{entity_index}"
+                for claim_index, claim in enumerate(entity.introducing_evidence):
+                    location_path = f"{entity_path}/introducing_evidence/{claim_index}"
+                    if not normalize(entity.label) or normalize(entity.label) not in normalize(
+                        claim.quote
+                    ):
+                        fail("NAME_NOT_IN_QUOTE", block_id=claim.block_id, item_path=location_path)
+                    if claim.artifact_id != context.artifact_id:
+                        fail("UNKNOWN_REFERENCE", block_id=claim.block_id, item_path=location_path)
+                        continue
+                    try:
+                        original = await block(claim.block_id)
+                    except LookupError:
+                        fail("UNKNOWN_REFERENCE", block_id=claim.block_id, item_path=location_path)
+                        continue
+                    if locate_quote(original.text, claim.quote, original.native_selector) is None:
+                        fail(
+                            "QUOTE_NOT_IN_SOURCE", block_id=claim.block_id, item_path=location_path
+                        )
+                    source_hashes[claim.block_id] = sha256(
+                        original.text.encode("utf-8")
+                    ).hexdigest()
+
+            if isinstance(candidate.object, EntityObjectV2):
+                obj = candidate.object
+                if obj.ref in declarations and obj.ref not in invalid_entities:
+                    declared = declarations[obj.ref][1]
+                    if normalize(obj.name) != normalize(declared.label):
+                        fail("NAME_NOT_IN_QUOTE", item_path=path + "/object")
+                if not any(
+                    normalize(obj.name) in normalize(claim.quote) for claim in candidate.evidence
+                ):
+                    fail("NAME_NOT_IN_QUOTE", item_path=path + "/object")
+                if obj.ref not in declarations:
+                    item_outcomes.append(
+                        outcome(
+                            index=index,
+                            path=path + "/object",
+                            candidate_id=candidate.id,
+                            block_id=candidate.evidence[0].block_id,
+                            disposition="SIGNAL",
+                            reason="OBJECT_UNDECLARED",
+                            raw=raw,
+                            excerpt=obj.name,
+                        )
+                    )
+                    candidate = candidate.model_copy(
+                        update={"object": LiteralObjectV2(kind="LITERAL", value=obj.name)}
+                    )
+
+            for ordinal, claim in enumerate(candidate.evidence):
+                evidence_path = f"{path}/evidence/{ordinal}"
+                if claim.artifact_id != context.artifact_id:
+                    fail("UNKNOWN_REFERENCE", block_id=claim.block_id, item_path=evidence_path)
+                    continue
+                try:
+                    original = await block(claim.block_id)
+                except LookupError:
+                    fail("UNKNOWN_REFERENCE", block_id=claim.block_id, item_path=evidence_path)
+                    continue
+                location = locate_quote(original.text, claim.quote, original.native_selector)
+                if location is None:
+                    fail("QUOTE_NOT_IN_SOURCE", block_id=claim.block_id, item_path=evidence_path)
+                    continue
+                evidence.append(
+                    ServerEvidence(
+                        evidence_id=uuid5(candidate.id, str(ordinal)),
+                        artifact_id=original.artifact_id,
+                        block_id=original.block_id,
+                        quote=claim.quote,
+                        normalization_version=NORMALIZATION_VERSION,
+                        precision=location.precision,
+                        selector=location.selector,
+                        text_origin=original.text_origin,
+                        origin_qualification=original.origin_qualification,
+                        producer=dict(original.producer) if original.producer is not None else None,
+                        producer_confidence=original.producer_confidence,
+                    )
+                )
+                source_hashes[claim.block_id] = sha256(original.text.encode("utf-8")).hexdigest()
+
+            for ordinal, ref in enumerate(candidate.time_mention_refs):
+                ref_path = f"{path}/time_mention_refs/{ordinal}"
+                try:
+                    time_ref = await self._sources.time_reference(context, ref)
+                    if (
+                        time_ref.id != ref
+                        or time_ref.tenant_id != context.tenant_id
+                        or time_ref.knowledge_base_id != context.knowledge_base_id
+                        or time_ref.artifact_id != context.artifact_id
+                    ):
+                        raise LookupError("time reference identity mismatch")
+                except LookupError:
+                    fail("UNKNOWN_REFERENCE", item_path=ref_path)
+                    continue
+                if not normalize(time_ref.words) or not any(
+                    claim.block_id == time_ref.block_id
+                    and normalize(time_ref.words) in normalize(claim.quote)
+                    for claim in candidate.evidence
+                ):
+                    fail("TIME_NOT_IN_QUOTE", block_id=time_ref.block_id, item_path=ref_path)
+                time_snapshots.append(wire_value(asdict(time_ref)))
+
+            outcomes.extend(item_outcomes)
+            if any(e.disposition == "REJECTED" for e in item_outcomes):
+                continue
+            eligibility = evaluate_eligibility(candidate, evidence)
+            accepted.append(
+                AdmittedAssertion(
+                    record=candidate,
+                    server_evidence=tuple(evidence),
+                    review_required=eligibility.review_required,
+                    reasons=eligibility.reasons,
+                    blocked_operations=eligibility.blocked_operations,
+                    created_by=context.actor_id,
+                    created_at=self._clock(),
+                ).with_metadata(
+                    AdmissionMetadata(
+                        raw_item_sha256=sha256(raw).hexdigest(),
+                        item_index=index,
+                        entity_snapshots=tuple(
+                            entity.model_dump(mode="json") for entity in selected.values()
+                        ),
+                        time_reference_snapshot=tuple(time_snapshots),
+                        source_hashes=source_hashes,
+                    )
+                )
+            )
+
+        if truncated:
+            outcomes.append(
+                outcome(
+                    index=None,
+                    path="/output",
+                    candidate_id=None,
+                    block_id=None,
+                    disposition="RUN_ISSUE",
+                    reason="TRUNCATED_OUTPUT",
+                    raw=b"",
+                )
+            )
+        for block_id in dict.fromkeys(uninterpreted_blocks):
+            outcomes.append(
+                outcome(
+                    index=None,
+                    path="/blocks/" + block_id,
+                    candidate_id=None,
+                    block_id=block_id,
+                    disposition="RUN_ISSUE",
+                    reason="BLOCK_UNINTERPRETED",
+                    raw=b"",
+                )
+            )
+        return AdmissionBatch(
+            schema_version=1,
+            run_id=context.run_id,
+            artifact_id=context.artifact_id,
+            accepted=tuple(accepted),
+            outcomes=tuple(outcomes),
+            requires_partial=bool(truncated or uninterpreted_blocks),
+        )

diff --git a/engine/packages/brain-assertions/src/brain_assertions/eligibility.py b/engine/packages/brain-assertions/src/brain_assertions/eligibility.py
new file mode 100644
index 0000000..7287dbf
--- /dev/null
+++ b/engine/packages/brain-assertions/src/brain_assertions/eligibility.py
@@ -0,0 +1,81 @@
+"""Independent server-side source restrictions; confidence never grants truth."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from dataclasses import dataclass
+from typing import Any
+
+from brain_contracts.assertions import wire_value
+
+ALL_OPERATIONS = ("RESOLVE", "CREATE", "AUTO_ACCEPT", "CLOSE", "SUPERSEDE")
+
+
+class AssertionIneligible(ValueError):
+    code = "ASSERTION_INELIGIBLE"
+
+    def __init__(self) -> None:
+        super().__init__(self.code)
+
+
+@dataclass(frozen=True)
+class Eligibility:
+    review_required: bool
+    reasons: tuple[str, ...]
+    blocked_operations: tuple[str, ...]
+
+
+def evaluate_eligibility(record: Any, evidence: Sequence[Any]) -> Eligibility:
+    record = wire_value(record)
+    support = [wire_value(item) for item in evidence]
+    reasons: list[str] = []
+    blocked: set[str] = set()
+    if record["assertion_kind"] == "OPEN_STATEMENT":
+        reasons.append("OPEN_STATEMENT")
+        blocked.update(ALL_OPERATIONS)
+    if "mood" in record["qualifiers"]:
+        reasons.append("MOOD")
+        blocked.update(ALL_OPERATIONS)
+    qualified_non_described = any(
+        e.get("origin_qualification") == "qualified"
+        and e.get("text_origin") in ("STATED", "OCR", "TRANSCRIBED")
+        and e.get("precision") != "unresolved"
+        for e in support
+    )
+    described = any(
+        e.get("origin_qualification") == "qualified" and e.get("text_origin") == "DESCRIBED"
+        for e in support
+    )
+    if described and not qualified_non_described:
+        reasons.append("DESCRIBED_EVIDENCE")
+        blocked.update(("AUTO_ACCEPT", "CLOSE", "SUPERSEDE"))
+    if not support or any(e.get("precision") == "unresolved" for e in support):
+        reasons.append("UNRESOLVED_EVIDENCE")
+        blocked.add("AUTO_ACCEPT")
+    if any(
+        e.get("origin_qualification") != "qualified" or e.get("text_origin") is None
+        for e in support
+    ):
+        reasons.append("LEGACY_UNQUALIFIED")
+        blocked.add("AUTO_ACCEPT")
+    return Eligibility(
+        bool(reasons), tuple(reasons), tuple(op for op in ALL_OPERATIONS if op in blocked)
+    )
+
+
+def require_eligible(
+    record: Any,
+    evidence: Sequence[Any],
+    *,
+    closes_existing: bool,
+    reviewed: bool = False,
+) -> None:
+    eligibility = evaluate_eligibility(record, evidence)
+    if "CREATE" in eligibility.blocked_operations:
+        raise AssertionIneligible()
+    if closes_existing and any(
+        op in eligibility.blocked_operations for op in ("CLOSE", "SUPERSEDE")
+    ):
+        raise AssertionIneligible()
+    if eligibility.review_required and not reviewed:
+        raise AssertionIneligible()

diff --git a/engine/packages/brain-assertions/src/brain_assertions/normalization.py b/engine/packages/brain-assertions/src/brain_assertions/normalization.py
new file mode 100644
index 0000000..a810c21
--- /dev/null
+++ b/engine/packages/brain-assertions/src/brain_assertions/normalization.py
@@ -0,0 +1,162 @@
+"""Versioned text normalization with conservative original-character mapping."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from collections.abc import Mapping
+from dataclasses import dataclass
+from typing import Any
+
+NORMALIZATION_VERSION = "f0006-grounding-v1"
+
+
+@dataclass(frozen=True)
+class NormalizedText:
+    text: str
+    ranges: tuple[tuple[int, int], ...]
+
+
+def _nfc_units(text: str) -> list[tuple[str, tuple[int, int]]]:
+    """Map an NFC combining sequence to its complete original source interval.
+
+    Sharing an interval between composed characters is intentional: a partial
+    match of a reordered sequence cannot claim a unique contiguous source span.
+    Hangul composition also joins adjacent non-combining Jamo code points.
+    """
+    result: list[tuple[str, tuple[int, int]]] = []
+    cluster = ""
+    start = 0
+    for index, char in enumerate(text):
+        joins = cluster and (
+            unicodedata.combining(char) != 0
+            or unicodedata.normalize("NFC", cluster + char)
+            != unicodedata.normalize("NFC", cluster) + char
+        )
+        if cluster and not joins:
+            result.extend((c, (start, index)) for c in unicodedata.normalize("NFC", cluster))
+            cluster = ""
+        if not cluster:
+            start = index
+        cluster += char
+    if cluster:
+        result.extend((c, (start, len(text))) for c in unicodedata.normalize("NFC", cluster))
+    return result
+
+
+def normalize_with_mapping(text: str) -> NormalizedText:
+    units = _nfc_units(text)
+    joined: list[tuple[str, tuple[int, int]]] = []
+    index = 0
+    while index < len(units):
+        char, interval = units[index]
+        if char in ("-", "\u2010", "\u00ad") and joined and joined[-1][0].isalpha():
+            end = index + 1
+            while end < len(units) and units[end][0].isspace():
+                end += 1
+            whitespace = "".join(c for c, _ in units[index + 1 : end])
+            if (
+                end < len(units)
+                and units[end][0].isalpha()
+                and any(c in whitespace for c in "\r\n")
+            ):
+                index = end
+                continue
+        joined.extend((c, interval) for c in char.casefold())
+        index += 1
+    collapsed: list[tuple[str, tuple[int, int]]] = []
+    for char, interval in joined:
+        if char.isspace():
+            if collapsed and collapsed[-1][0] == " ":
+                collapsed[-1] = (" ", (collapsed[-1][1][0], interval[1]))
+            else:
+                collapsed.append((" ", interval))
+        else:
+            collapsed.append((char, interval))
+    final = [
+        item
+        for index, item in enumerate(collapsed)
+        if not (
+            item[0] == " "
+            and (
+                (index > 0 and unicodedata.category(collapsed[index - 1][0]) == "Sc")
+                or (
+                    index + 1 < len(collapsed)
+                    and unicodedata.category(collapsed[index + 1][0]) == "Sc"
+                )
+            )
+        )
+    ]
+    return NormalizedText("".join(c for c, _ in final), tuple(interval for _, interval in final))
+
+
+def normalize(text: str) -> str:
+    return normalize_with_mapping(text).text
+
+
+def normalize_name(text: str) -> str:
+    """Document-local admission key; deliberately excludes grounding rewrites."""
+    return re.sub(r"\s+", " ", unicodedata.normalize("NFC", text).casefold()).strip()
+
+
+def match_positions(source: str, quote: str) -> tuple[tuple[int, int], ...]:
+    haystack, needle = normalize(source), normalize(quote)
+    if not needle:
+        return ()
+    result: list[tuple[int, int]] = []
+    start = 0
+    while (index := haystack.find(needle, start)) >= 0:
+        result.append((index, index + len(needle)))
+        start = index + 1
+    return tuple(result)
+
+
+@dataclass(frozen=True)
+class GroundedLocation:
+    precision: str
+    selector: dict[str, Any]
+
+
+def locate_quote(
+    source: str, quote: str, native_selector: Mapping[str, Any]
+) -> GroundedLocation | None:
+    """Locate in retained text, retaining native coordinates and honest ambiguity."""
+    normalized = normalize_with_mapping(source)
+    matches = match_positions(source, quote)
+    if not matches:
+        return None
+    selector = dict(native_selector)
+    declared = selector.pop("precision", None)
+    regions = selector.get("regions", [])
+    if selector.get("kind") == "unresolved":
+        return GroundedLocation("unresolved", selector)
+    if selector.get("cell_id") is not None or declared == "table_cell":
+        # A source-verified cell identifies the cell even when its text repeats.
+        return GroundedLocation("table_cell", selector)
+    if (
+        len(matches) == 1
+        and declared not in ("page", "document", "unresolved")
+        and len(regions) <= 1
+    ):
+        first, last = matches[0]
+        ranges = normalized.ranges[first:last]
+        start, end = min(a for a, _ in ranges), max(b for _, b in ranges)
+        # Case folding can expand ß→ss, and NFC can reorder combining marks.
+        # Only a complete original interval that normalizes exactly may be a span.
+        if normalize(source[start:end]) == normalize(quote) and (
+            selector.get("native_ref") or selector.get("block_id")
+        ):
+            base = selector.get("char_start")
+            if type(base) is not int:
+                base = 0
+            selector.update(char_start=base + start, char_end=base + end)
+            return GroundedLocation("span", selector)
+    selector.pop("char_start", None)
+    selector.pop("char_end", None)
+    if selector.get("block_id") or selector.get("native_ref"):
+        return GroundedLocation("block", selector)
+    if type(selector.get("page")) is int:
+        return GroundedLocation("page", selector)
+    if declared == "document" or selector.get("document_version_id"):
+        return GroundedLocation("document", selector)
+    return GroundedLocation("unresolved", selector)

