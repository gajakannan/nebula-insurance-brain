[project]
name = "brain-engine-workspace"
version = "0.0.0"
description = "uv workspace root for the engine/ runtime (F0001-S0001). No source of its own; see apps/api and packages/*."
requires-python = ">=3.13"
dependencies = ["brain-api", "brain-content", "brain-persistence", "brain-domain", "brain-security", "brain-review", "brain-temporal", "brain-worker", "brain-assertions"]

[tool.uv]
package = false
exclude-newer = "7 days"

[tool.uv.sources]
brain-api = { workspace = true }
brain-content = { workspace = true }
brain-persistence = { workspace = true }
brain-domain = { workspace = true }
brain-security = { workspace = true }
brain-review = { workspace = true }
brain-temporal = { workspace = true }
brain-worker = { workspace = true }
brain-assertions = { workspace = true }
brain-contracts = { workspace = true }
brain-testing = { workspace = true }

[tool.uv.workspace]
members = ["apps/*", "packages/*"]

[dependency-groups]
dev = [
  "brain-testing",
  "pytest>=8.0",
  "pytest-cov>=5.0",
  "pytest-asyncio>=0.24",
  "httpx2>=2.12",
  "ruff>=0.8",
  "mypy>=1.13",
  "alembic>=1.13",
  "types-PyYAML>=6.0",
  "aiosqlite>=0.20",
  "psycopg[binary]>=3.2",
  "jsonschema>=4.23",
]

[tool.pytest.ini_options]
# Every package (apps/api, packages/*) ships its own tests/ directory — the default
# prepend import mode collides on the shared bare module name "tests" once more than
# one is collected in the same run. importlib mode keys each module by file path.
addopts = "--import-mode=importlib"
asyncio_mode = "auto"
