                        Override the resolved run folder (tests/advanced).
  --spec-dir SPEC_DIR
  --dry-run
  --from FROM_OP        Resume from an operation id (cannot skip an unattested
                        checkpoint).
  --force               Re-run a completed stage (non-idempotent replay).
  --list
  --attest-checkpoint ATTEST
  --reattest-checkpoint REATTEST
                        Append an audited replacement for a stale attestation
