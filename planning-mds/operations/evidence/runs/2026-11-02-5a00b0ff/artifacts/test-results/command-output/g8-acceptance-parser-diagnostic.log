1050-        elif entry.get("type") == "multi_line_scanner":
1051-            scanners[name] = entry
1052-            anchors[name] = re.compile(entry["anchor_regex"], re.MULTILINE)
1053-    return SecretScanner(regex_classes=regex_classes, scanners=scanners, anchor_patterns=anchors)
