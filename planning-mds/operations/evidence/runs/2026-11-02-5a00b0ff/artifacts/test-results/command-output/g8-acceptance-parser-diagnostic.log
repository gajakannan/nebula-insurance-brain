1041-def build_secret_scanner(patterns: dict[str, Any]) -> SecretScanner:
1042-    regex_classes: dict[str, re.Pattern[str]] = {}
1043-    scanners: dict[str, dict[str, Any]] = {}
1044-    anchors: dict[str, re.Pattern[str]] = {}
