1002-                text=match.group("text").strip(),
1003-                owner=owner.strip() if owner else None,
1004-                follow_up=match.group("followup").strip() if match.group("followup") else None,
1005-                raw=match.group(0).strip(),
1006-            )
1007-        )
1008-    return recs
