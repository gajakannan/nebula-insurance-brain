def _is_repo_relative(value: str) -> tuple[bool, bool]:
    """Returns (absolute, traverses). Both False means safe relative path."""
    if not value:
        return False, False
    if value.startswith("/") or re.match(r"^[A-Za-z]:[\\/]", value):
        return True, False
    parts = re.split(r"[\\/]+", value)
    return False, ".." in parts


