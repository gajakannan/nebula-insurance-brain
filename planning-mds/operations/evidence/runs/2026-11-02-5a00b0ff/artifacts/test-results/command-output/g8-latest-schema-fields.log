def _find_gate(spec: dict[str, Any], stage: str) -> dict[str, Any]:
    for gate in spec.get("gates", []) or []:
        if isinstance(gate, dict) and gate.get("id") == stage:
            return gate
    raise GateDriverError("unknown_stage", f"action has no gate {stage!r}")


