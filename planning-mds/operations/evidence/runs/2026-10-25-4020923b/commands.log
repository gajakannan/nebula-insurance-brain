{"schema_version":1,"timestamp":"2026-10-25T23:22:56-04:00","cwd":"{NEBULA_PRODUCT_ROOT}","command":"python3 - <<'PY'\nimport json, os, pathlib, re, stat, subprocess, urllib.error, urllib.request\n\nsecret_path = pathlib.Path.home() / \".brain-secrets\"\nprint(f\"secret_file_exists={secret_path.is_file()}\")\nkey = None\nif secret_path.is_file():\n    mode = stat.S_IMODE(secret_path.stat().st_mode)\n    print(f\"secret_file_mode={mode:04o}\")\n    contents = secret_path.read_text()\n    key_match = re.search(r\"\"\"^export BRAIN_INFERENCE_API_KEY=['\"]?([^'\"\\n$]+)['\"]?$\"\"\", contents, re.M)\n    key = key_match.group(1) if key_match else None\n    print(f\"api_key_present={bool(key)}\")\n    print(f\"key_is_persisted_literal={bool(key) and '$(' not in contents}\")\n    print(f\"vllm_key_uses_brain_key={'export VLLM_API_KEY=\"$BRAIN_INFERENCE_API_KEY\"' in contents}\")\n    print(f\"permissions_private={mode == 0o600}\")\n\ngpu = subprocess.run([\"nvidia-smi\", \"--query-gpu=name,memory.total,memory.free,driver_version\", \"--format=csv,noheader\"], text=True, capture_output=True)\nprint(f\"nvidia_smi_exit={gpu.returncode}\")\nprint(f\"gpu_probe={((gpu.stdout or gpu.stderr).strip().splitlines() or ['no output'])[0]}\")\n\ntorch_python = pathlib.Path.home() / \".venvs/brain-vllm/bin/python\"\nif torch_python.exists():\n    probe = subprocess.run([str(torch_python), \"-c\", \"import torch; print(f'torch={torch.__version__} cuda={torch.cuda.is_available()} devices={torch.cuda.device_count()}')\"], text=True, capture_output=True)\n    print(f\"torch_probe_exit={probe.returncode}\")\n    print(f\"torch_probe={(probe.stdout or probe.stderr).strip().splitlines()[-1] if (probe.stdout or probe.stderr).strip() else 'no output'}\")\nelse:\n    print(\"torch_probe=brain-vllm venv missing\")\n\nif key:\n    req = urllib.request.Request(\"http://127.0.0.1:8000/v1/models\", headers={\"Authorization\": f\"Bearer {key}\"})\n    try:\n        with urllib.request.urlopen(req, timeout=4) as response:\n            payload = json.loads(response.read())\n            model_ids = [item.get(\"id\") for item in payload.get(\"data\", [])]\n            print(f\"inference_http_status={response.status}\")\n            print(f\"inference_model_ids={model_ids}\")\n    except urllib.error.HTTPError as error:\n        print(f\"inference_http_status={error.code}\")\n        print(\"inference_probe=HTTP response received; model listing not authorized or unavailable\")\n    except Exception as error:\n        print(f\"inference_probe_error={type(error).__name__}: {error}\")\nelse:\n    print(\"inference_probe=skipped; no persisted Brain API key found\")\nPY","exit_code":0,"artifacts":[],"redactions":[]}
